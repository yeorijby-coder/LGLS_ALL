# =====================================================================
# HOST_SIM (WMS/IMS 시뮬레이터) 설정
# =====================================================================

[ECS]
# ECS 명령 채널: HOST_SIM 이 클라이언트로 접속 (ECS_PORT)
IP=127.0.0.1
PORT=9911

[REPORT]
# ECS 보고 채널: HOST_SIM 이 서버로 수신대기 (ECS 의 WMS_HOST:WMS_PORT 가 여기로 접속)
PORT=9910

[COMMON]
# 하이랙 스테이션 코드 베이스: SC#k = BASE+k (201~205, TB_CODEMASTER codeclass 022, KR01)
RACK_STATION_BASE=200
# 랙 Bay/Level 최대값 (셀 순환 범위)
MAX_BAY=10
MAX_LEVEL=10

# ---------------------------------------------------------------------
# 로직별 설정
#  IN_STATION  : 입고대 스테이션 코드   OUT_STATION : 출고대 스테이션 코드
#  SC          : 담당 스태커크레인 번호(콤마 구분) → Bank = 2k-1, 2k
#  스테이션 코드: 101=C/V#11(TR#22) 102=C/V#12(TR#24) 103=C/V#13(TR#26)
#                 104=C/V#14(TR#29) 105=C/V#15(TR#30)
# ---------------------------------------------------------------------

[LOGIC1]
ENABLED=1
# ※ 주의: 요청서에는 입고대 C/V#13(TR#26), 출고대 C/V#12(TR#24)로 되어 있으나,
#    ECS 소스(IsInputConveyor={..12..}, OnWaitOut의 CONVEYOR:13 통과전용 처리)와
#    DB 경로(TB_ITINERARY I002 입고시작=CV#12, O032 출고종점=CV#13)상
#    CV#12 = 입고대(TR#24), CV#13 = 출고대(TR#26) 입니다. 시스템과 일치하도록 설정함.
#    (요청서대로 강제하려면 IN_STATION=103, OUT_STATION=102 로 변경 — 단, ECS가 처리 못함)
# [LGLS 2026-07-15] EcsDefine(WCS Client) 기준으로 정렬: 124=출고대(RetStation), 126=입고대(StoStation).
#   따라서 입고대=126(C/V#13), 출고대=124(C/V#12). (예전엔 반대였음)
IN_STATION=126
OUT_STATION=124
SC=1

[LOGIC2]
ENABLED=1
# 입고대 : C/V#15 -> TR#30 (코드 105) / 출고대 : C/V#14 -> TR#29 (코드 104)
# [대체 시스템] 입고대 TR#30(C/V#15)=130 / 출고대 TR#29(C/V#14)=129
# (원본 ECS 연동 시: IN=105, OUT=104)
IN_STATION=130
OUT_STATION=129
SC=2,3

[LOGIC3]
ENABLED=1
# 입고대 : C/V#11 -> TR#22 (코드 101) / 출고대 : C/V#11 -> TR#22 (코드 101)
# [대체 시스템] 입출고대 TR#22(C/V#11)=122
# (원본 ECS 연동 시: IN=OUT=101)
IN_STATION=122
OUT_STATION=122
SC=4,5
