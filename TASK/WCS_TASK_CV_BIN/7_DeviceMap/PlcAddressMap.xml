    </Block>
    <Block name="Ack" device="M" origin="1616" stride="16" legacy="M0650">
      <Signal name="TransferRequest" offset="0" tag="TRANSFER_REQUEST" />
      <Signal name="LoadCompleteAck" offset="1" tag="LOAD_COMPLETE_ACK" />
      <Signal name="UnloadCompleteAck" offset="2" tag="UNLOAD_COMPLETE_ACK" />
      <Signal name="AlarmSetReportAck" offset="3" tag="ALARM_SET_REPORT_ACK" />
      <Signal name="AlarmResetReportAck" offset="4" tag="ALARM_RESET_REPORT_ACK" />
      <Signal name="TransferComplete" offset="5" tag="TRANSFER_COMPLETE_ACK" />
    </Block>
    <Block name="Status" device="D" origin="336" stride="16" legacy="D0210">
      <Signal name="SubsystemStatus" offset="0" tag="SUBSYSTEM_STATUS" />
      <Signal name="TransferCompleteLocation" offset="3" words="3" tag="TRANSFER_COMPLETE_LOCATION_01" />
      <Signal name="SubsystemLocation" offset="6" words="3" tag="SUBSYSTEM_LOCATION_01" desc="설비 현재위치" />
    </Block>
    <Block name="Command" device="D" origin="848" stride="16" legacy="D0370">
      <Signal name="From" offset="0" words="3" tag="FROM_01" />
      <Signal name="To" offset="3" words="3" tag="TO_01" />
      <Signal name="JobNo" offset="6" words="2" tag="PALLET_ID" />
    </Block>
    <Block name="Tracking" device="R" origin="310" stride="2" perSlotWords="2" legacy="R0310">
      <Signal name="PalletOnVehicle" offset="0" words="2" encoding="ascii4" tag="PALLET_ON_VEHICLE" />
    </Block>
  </EquipGroup>

  <!-- ══ 전 설비 공통 단일주소 ══ -->
  <Global name="Alarm" device="M" desc="S/C #1 알람(대표) - 사이클당 1회 점검">
    <Signal name="AlarmSet" addr="786" legacy="M0492" />
    <Signal name="AlarmReset" addr="787" legacy="M0493" />
    <Signal name="AlarmSetAck" addr="1539" legacy="M0963" />
    <Signal name="AlarmResetAck" addr="1540" legacy="M0964" />
  </Global>

  <!-- ══ 설비 레이아웃 (SYS_MAIN 하드코딩 배열 대체) ══ -->
  <Equipments>
    <Equip plc="01" type="CV" no="1" frTrack="101" toTrack="102" />
    <Equip plc="02" type="CV" no="2" frTrack="103" toTrack="104" />
