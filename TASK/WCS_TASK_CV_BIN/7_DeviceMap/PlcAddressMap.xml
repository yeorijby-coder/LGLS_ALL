<?xml version="1.0" encoding="utf-8"?>
<!--
  LGLS WCS - PLC 주소맵 / 시나리오 정의  (PPT V1.3 기준)
  ─────────────────────────────────────────────────────────────────────
  이 파일 하나만 고치면 아래가 모두 따라간다.
    · 자동운전 통신 : CvThread (이벤트/ACK 비트, 방향 워드, R 트래킹, 알람)
    · 화면          : PLC 메모리 맵 (Bit/Word/Tracking 탭)
    · 시나리오 테스트: 아래 <Scenarios> 정의를 그대로 사용
  주소 규칙
    · M(비트) : 워드주소 = 비트주소/16, 비트위치 = 비트주소%16
    · D(워드) : %DB(바이트표기) = 워드주소 x 2
    · R(트래킹) : 문서표기를 R_ADDR_MODE(HEX=구ECS 16진 / DEC=현행 10진)로 해석
  블록 주소식 : base = origin + (설비번호 - numberFrom) x stride,  주소 = base + offset
-->
<PlcAddressMap version="1.3" desc="PPT V1.3 (2026-08-19) 기준">

  <!-- 디바이스 코드/단위 규약 -->
  <Conventions>
    <Device code="M" id="0x90" unit="bit"  wordDivisor="16" desc="내부릴레이(이벤트/ACK/알람)" />
    <Device code="D" id="0xA8" unit="word" byteToWord="2"   desc="데이터레지스터(방향/상태/명령)" />
    <Device code="R" id="0xAF" unit="word" byteToWord="2"   desc="파일레지스터(트래킹) - R_ADDR_MODE 적용" />
  </Conventions>

  <!-- ══ C/V (컨베이어) 15대 : 동일 오프셋 패턴 반복 ══ -->
  <EquipGroup type="CV" numberFrom="1" count="15">

    <Block name="Event" device="M" origin="256" stride="32" readWords="2" legacy="M0160" desc="설비→WCS 이벤트">
      <Signal name="UnloadComplete1" offset="1" />
      <Signal name="LoadComplete1" offset="2" />
      <Signal name="UnloadComplete2" offset="3" />
      <Signal name="LoadComplete2" offset="4" />
      <Signal name="WorkInstruction" offset="5" used="false" />
      <Signal name="WorkOrder" offset="6" />
      <Signal name="InReady2" offset="7" />
      <Signal name="OperationMode" offset="8" />
      <Signal name="UnloadRequest2Ack" offset="9" appliesTo="14,15" />
      <SignalArray name="PalletExist" offset="16" perSlot="1" maxSlots="10" desc="포지션별 파렛트 감지(슬롯 0부터)" />
    </Block>

    <Block name="Ack" device="M" origin="1280" stride="16" legacy="M0800" desc="WCS→설비 응답/지시">
      <Signal name="UnloadComplete1Ack" offset="1" />
      <Signal name="LoadComplete1Ack" offset="2" />
      <Signal name="UnloadComplete2Ack" offset="3" />
      <Signal name="LoadComplete2Ack" offset="4" />
      <Signal name="UnloadRequest2" offset="5" appliesTo="14,15" />
    </Block>

    <Block name="Direction" device="D" origin="480" stride="1" length="1" legacy="D0300" desc="입출고 방향(ASCII)">
      <Signal name="IoDirection" offset="0" encoding="ascii" valueMap="0=IN,1=OUT" />
    </Block>

    <Block name="Tracking" device="R" origin="0" stride="10" perSlotWords="2" maxSlots="3" legacy="R0000" desc="작업번호 트래킹(슬롯당 2워드, ASCII 4자리)">
      <Signal name="JobNo" offset="0" words="2" encoding="ascii4" />
    </Block>
  </EquipGroup>

  <!-- ══ S/C (스태커크레인) 5대 ══ -->
  <EquipGroup type="SC" numberFrom="1" count="5">
    <Block name="Event" device="M" origin="768" stride="32" legacy="M0300">
      <Signal name="PalletExistFlag" offset="0" tag="PALLET_EXIST_FLAG" />
      <Signal name="LoadComplete" offset="16" tag="LOAD_COMPLETE" />
      <Signal name="UnloadComplete" offset="17" tag="UNLOAD_COMPLETE" />
      <Signal name="AlarmSetReport" offset="18" tag="ALARM_SET_REPORT" />
      <Signal name="AlarmResetReport" offset="19" tag="ALARM_RESET_REPORT" />
      <Signal name="TransferAck" offset="20" tag="TRANSFER_ACK" />
    </Block>
    <Block name="Ack" device="M" origin="1536" stride="16" legacy="M0600">
      <Signal name="TransferRequest" offset="0" tag="TRANSFER_REQUEST" />
      <Signal name="LoadCompleteAck" offset="1" tag="LOAD_COMPLETE_ACK" />
      <Signal name="UnloadCompleteAck" offset="2" tag="UNLOAD_COMPLETE_ACK" />
      <Signal name="AlarmSetReportAck" offset="3" tag="ALARM_SET_REPORT_ACK" />
      <Signal name="AlarmResetReportAck" offset="4" tag="ALARM_RESET_REPORT_ACK" />
      <Signal name="TransferComplete" offset="5" tag="TRANSFER_COMPLETE_ACK" />
    </Block>
    <Block name="Status" device="D" origin="256" stride="16" legacy="D0160" desc="설비→WCS 상태">
      <Signal name="SubsystemStatus" offset="0" tag="SUBSYSTEM_STATUS" />
      <Signal name="AlarmSetCode" offset="1" tag="ALARM_SET_CODE" />
      <Signal name="AlarmResetCode" offset="2" tag="ALARM_RESET_CODE" />
      <Signal name="TransferCompleteLocation" offset="3" words="3" tag="TRANSFER_COMPLETE_LOCATION_01" />
      <Signal name="SubsystemLocation" offset="6" words="3" tag="SUBSYSTEM_LOCATION_01" desc="설비 현재위치(열/연/단)" />
      <Signal name="OperationMode" offset="9" tag="OPERATION_MODE" />
    </Block>
    <Block name="Command" device="D" origin="768" stride="16" legacy="D0320" desc="WCS→설비 반송지시">
      <Signal name="From" offset="0" words="3" tag="FROM_01" />
      <Signal name="To" offset="3" words="3" tag="TO_01" />
      <Signal name="JobNo" offset="6" words="2" tag="PALLET_ID" />
    </Block>
    <Block name="Tracking" device="R" origin="300" stride="2" perSlotWords="2" legacy="R0300">
      <Signal name="PalletOnVehicle" offset="0" words="2" encoding="ascii4" tag="PALLET_ON_VEHICLE" />
    </Block>
  </EquipGroup>

  <!-- ══ RGV (반송대차) 1대 ══ -->
  <EquipGroup type="RGV" numberFrom="1" count="1">
    <Block name="Event" device="M" origin="928" stride="32" legacy="M03A0">
      <Signal name="PalletExistFlag" offset="0" tag="PALLET_EXIST_FLAG" />
      <Signal name="LoadComplete" offset="16" tag="LOAD_COMPLETE" />
      <Signal name="UnloadComplete" offset="17" tag="UNLOAD_COMPLETE" />
