      <Step kind="observe" equip="CV" no="14" block="Event" signal="WorkOrder" value="on" desc="W.O ON" />
      <Step kind="word" device="R" equip="CV" no="14" block="Tracking" signal="JobNo" slot="2" isString="true" src="CvThread.cs::CvTrackingWrite" desc="JOB NO #29 Tracking Write" />
      <Step kind="observe" equip="CV" no="14" block="Event" signal="UnloadRequest2Ack" value="on" desc="Unload Request #2 Ack ON" />
