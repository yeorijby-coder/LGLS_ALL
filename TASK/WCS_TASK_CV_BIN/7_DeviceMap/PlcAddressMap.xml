  <!-- ══ 시나리오 (PPT 반송 시나리오) ══
       Step 주소는 심볼 참조(equip/block/signal/slot)로 적는다.
       → 위 Block 의 origin/stride 만 고치면 모든 스텝 주소가 자동으로 따라간다.
       kind : observe=설비 신호 관측 / force=WCS 비트 강제 송신 / word=D·R 워드 송신 -->
  <Scenarios>
    <Scenario title="반송 시나리오 (입고 : C/V #11) — 슬라이드 8~9">
      <Step kind="observe" equip="CV" no="11" block="Event" signal="PalletExist" slot="1" value="on" desc="Pallet Exist #22 ON (입고대 적재)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="LoadComplete2" value="on" desc="Load Complete #2 ON" />
      <Step kind="force" equip="CV" no="11" block="Ack" signal="LoadComplete2Ack" desc="Load Complete Ack #2 ON (WCS)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="LoadComplete2" value="off" desc="Load Complete #2 OFF" />
      <Step kind="observe" equip="CV" no="11" block="Ack" signal="LoadComplete2Ack" value="off" desc="Load Complete Ack #2 OFF (설비/PLC 리셋)" />
      <Step kind="word" device="D" equip="CV" no="11" block="Direction" signal="IoDirection" src="CvThread.cs::CvStatusScenario" desc="Direction Mode Check &#x27;1&#x27; (입고0/출고1)" />
      <Step kind="word" device="R" equip="CV" no="11" block="Tracking" signal="JobNo" slot="1" isString="true" src="CvThread.cs::CvTrackingWrite" desc="JOB NO #22 최초 기록 (입고 진입 시 #22 위치에 JOB Write)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="PalletExist" slot="1" value="off" desc="Pallet Exist #22 OFF (ID Shift)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="PalletExist" slot="0" value="on" desc="Pallet Exist #21 ON (#21 도착)" />
      <Step kind="word" device="R" equip="CV" no="11" block="Tracking" signal="JobNo" slot="0" isString="true" desc="PLC ID Shift 결과: #22(R0102) JOB → #21(R0100)로 이동(원위치 #22 클리어)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="WorkOrder" value="on" desc="W.O 보고 (RGV Call)" />
      <Step kind="word" device="R" equip="CV" no="11" block="Tracking" signal="JobNo" slot="0" isString="true" desc="(슬9) RGV Call 시 #21(R0100) 반출 대상 JOB 재표시 — RGV지시는 D0530~" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="PalletExist" slot="0" value="off" desc="Pallet Exist #21 OFF (RGV Load 완료)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="UnloadComplete1" value="on" desc="Unload Complete #1 ON" />
      <Step kind="force" equip="CV" no="11" block="Ack" signal="UnloadComplete1Ack" desc="Unload Complete Ack #1 ON (WCS)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="UnloadComplete1" value="off" desc="Unload Complete #1 OFF" />
      <Step kind="observe" equip="CV" no="11" block="Ack" signal="UnloadComplete1Ack" value="off" desc="Unload Complete Ack #1 OFF (설비/PLC 리셋)" />
      <Step kind="observe" equip="CV" no="11" block="Event" signal="WorkOrder" value="off" desc="W.O OFF" />
    </Scenario>
    <Scenario title="반송 시나리오 (출고 : C/V #11) — 슬라이드 10~11">
