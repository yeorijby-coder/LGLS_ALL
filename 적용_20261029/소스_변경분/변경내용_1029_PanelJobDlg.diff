+		(LPCTSTR)m_listSeq.GetItemText(nLast, 1), (LPCTSTR)m_listSeq.GetItemText(nLast, 2));
+	AfxMessageBox(strMsg, MB_ICONINFORMATION);
+	return TRUE;
