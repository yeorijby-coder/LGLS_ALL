+	CString strCells;
+	for (int j = 0; j < nCnt; j++) if (m_arSeqToTrk[j] > 0) { if (!strCells.IsEmpty()) strCells += _T(", "); strCells += PortText(m_arSeqToTrk[j]); }
+	CString strMsg;
+	strMsg.Format(_T("작업 상태는 [%s] 인데 경로의 어느 칸(%s)에도 화물이 감지되지 않습니다.\n\n")
