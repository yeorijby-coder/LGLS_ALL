+BOOL CPanelJobDlg::RouteSearchOffer(const ROW& r, int nSeq, BOOL bAlreadyDone)
+{
+	if (m_bRouteSearch || m_pDoc == NULL) return FALSE;
+	const int nCnt = (int)m_arSeqToTrk.GetCount();
