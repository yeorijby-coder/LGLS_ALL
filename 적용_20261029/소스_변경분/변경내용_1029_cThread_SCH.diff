+        // ─────────────────────────────────────────────────────────────────
+        // [LGLS 2026-10-29] 이력 정리 - DEL_HIS_SETTING 의 보존기간이 지난 행을 지운다.
+        //   종전에는 이 표를 Client 설정 화면(ConfigLogDelete)이 보여 주고 고치기만 했을 뿐,
+        //   어느 프로그램도 읽어 지우지 않았다(구 ECS/ECP 에도 없고 Express 라 Agent 잡도 없다).
+        //   개발 DB 는 9/2 부터 WCS_LOG_PGR 133만 건, JOB_MST_HIS 28만 건이 그대로 쌓여 있었다.
+        //
+        //   동작
+        //     - HIS_DEL_INTERVAL_MIN 마다 DEL_HIS_SETTING 을 다시 읽는다(Client 에서 고치면 재기동 없이 반영).
+        //       unit 이 DAY/HOUR/MONTH 이고 cycle 이 1 이상인 행만 대상. empty_ret_auto_del(Y/N) 같은 행은 건너뛴다.
+        //     - 표·key_column 이 DB 에 없으면 건너뛰고 한 번만 알린다(설정표에는 이 현장에 없는 표도 적혀 있다).
+        //     - ★사이클당 표마다 한 배치(HIS_DEL_BATCH 행)만 지우고 다음 사이클로 넘긴다★ - 메인 루프(200ms)가
+        //       스케줄링을 멈추지 않게. 적체가 남아 있으면 다음 사이클에 이어서 지운다.
+        //     - 다 지우면 표별 건수·소요를 한 줄로 남긴다. 대상이 없던 검사는 일반 로그 한 줄.
+        //   ENV_IOSCH.INI [CNF]
+        //     HIS_DEL_ENABLE       1 = 동작(기본) / 0 = 끔
+        //     HIS_DEL_INTERVAL_MIN 검사 간격(분). 기본 60, 최소 1
+        //     HIS_DEL_BATCH        한 번에 지우는 행 수. 기본 2000, 최소 100
+        //     HIS_DEL_START_SEC    기동 후 첫 검사까지 대기(초). 기본 120
+        //   호출마다 읽으므로 재기동 불필요.
+        // ─────────────────────────────────────────────────────────────────
+        #region PurgeHistory
+        private DateTime m_dtNextPurge = DateTime.MinValue;          // 다음 검사 시각(MinValue = 기동 직후 START_SEC 로 잡는다)
+        private List<HisPurgeItem> m_lstPurge = null;                // 이번 검사에서 지울 표 목록(남은 것)
+        private DateTime m_dtPurgeBegin = DateTime.MinValue;
+        private readonly HashSet<string> m_setPurgeSkipLogged = new HashSet<string>();   // 표/컬럼 없음 안내는 표당 1회
+
+        private class HisPurgeItem
+        {
+            public string Table;      // 설정표의 table_name (소문자 그대로)
+            public string Column;     // key_column (없으면 INS_DT)
+            public int    Cycle;      // 보존 수
+            public string Unit;       // DAY / HOUR / MONTH
+            public bool   HasWhTyp;   // 표에 WH_TYP 열이 있으면 창고구분으로 좁힌다
+            public long   Deleted;    // 누적 삭제 건수
+        }
+
+        private static bool HIS_DEL_ENABLE       { get { return cDefApi.GsReadInitProfileCnf("HIS_DEL_ENABLE", 1) != 0; } }
+        private static int  HIS_DEL_INTERVAL_MIN { get { int v = cDefApi.GsReadInitProfileCnf("HIS_DEL_INTERVAL_MIN", 60); return v < 1 ? 1 : v; } }
+        private static int  HIS_DEL_BATCH        { get { int v = cDefApi.GsReadInitProfileCnf("HIS_DEL_BATCH", 2000); return v < 100 ? 100 : v; } }
+        private static int  HIS_DEL_START_SEC    { get { int v = cDefApi.GsReadInitProfileCnf("HIS_DEL_START_SEC", 120); return v < 0 ? 0 : v; } }
+
+        /// <summary>식별자(표·열 이름)에 영문·숫자·_ 만 허용 - 설정표 값을 SQL 에 그대로 붙이므로.</summary>
+        private static bool IsSafeIdent(string s)
+        {
+            if (string.IsNullOrEmpty(s) || s.Length > 64) return false;
+            foreach (char c in s)
+                if (!(char.IsLetterOrDigit(c) || c == '_')) return false;
+            return true;
+        }
+
+        private void PurgeHistory()
+        {
+            try
+            {
+                if (_pBdb == null) return;
+                DateTime now = DateTime.Now;
+
+                // ── 적체 처리 중 : 사이클마다 한 배치씩
+                if (m_lstPurge != null)
+                {
+                    PurgeHistoryStep();
+                    return;
+                }
+
+                if (m_dtNextPurge == DateTime.MinValue) { m_dtNextPurge = now.AddSeconds(HIS_DEL_START_SEC); return; }
+                if (now < m_dtNextPurge) return;
+                m_dtNextPurge = now.AddMinutes(HIS_DEL_INTERVAL_MIN);
+
+                if (!HIS_DEL_ENABLE) return;
+
+                // ── 설정 읽기
+                string q = "";
+                q += CRLF + " SELECT TABLE_NAME, CYCLE, UNIT, KEY_COLUMN ";
+                q += CRLF + "   FROM DEL_HIS_SETTING ";
+                q += CRLF + "  WHERE WH_TYP = :WH_TYP ";
+                _pBdb.mComMain.CommandType = CommandType.Text;
+                _pBdb.mComMain.Parameters.Clear();
+                _pBdb.mComMain.Parameters.Add("WH_TYP", DbLang.VARCHAR).Value = SCH_WH_TYP;
+                if (DbQry(q) < 0) return;
+                DataTable dt = _pBdb.mDtMain.Copy();
+
+                List<HisPurgeItem> lst = new List<HisPurgeItem>();
+                foreach (DataRow r in dt.Rows)
+                {
+                    string tbl  = GetVal(r, "TABLE_NAME").ToLower();
+                    string unit = GetVal(r, "UNIT").ToUpper();
+                    string col  = GetVal(r, "KEY_COLUMN").ToUpper();
+                    int cycle; int.TryParse(GetVal(r, "CYCLE"), out cycle);
+
+                    if (unit != "DAY" && unit != "HOUR" && unit != "MONTH") continue;   // Y/N 류(empty_ret_auto_del)는 대상 아님
+                    if (cycle < 1) continue;
+                    if (col == "") col = "INS_DT";
+                    if (!IsSafeIdent(tbl) || !IsSafeIdent(col)) { PurgeSkipOnce(tbl, "이름이 올바르지 않음 (" + tbl + "." + col + ")"); continue; }
+
+                    // 표·열이 이 DB 에 있는지 (설정표에는 다른 현장의 표도 적혀 있다)
+                    string chk = " SELECT CASE WHEN OBJECT_ID('" + tbl + "', 'U') IS NULL THEN 0 ELSE 1 END AS HAS_TBL, "
+                               + "        CASE WHEN COL_LENGTH('" + tbl + "', '" + col + "') IS NULL THEN 0 ELSE 1 END AS HAS_COL, "
+                               + "        CASE WHEN COL_LENGTH('" + tbl + "', 'WH_TYP') IS NULL THEN 0 ELSE 1 END AS HAS_WH ";
+                    _pBdb.mComMain.CommandType = CommandType.Text;
+                    _pBdb.mComMain.Parameters.Clear();
+                    if (DbQry(chk) < 0 || _pBdb.mDtMain.Rows.Count == 0) continue;
+                    DataRow c = _pBdb.mDtMain.Rows[0];
+                    if (GetVal(c, "HAS_TBL") != "1") { PurgeSkipOnce(tbl, "표가 없음"); continue; }
+                    if (GetVal(c, "HAS_COL") != "1") { PurgeSkipOnce(tbl, "기준 열 " + col + " 이 없음"); continue; }
+
+                    HisPurgeItem it = new HisPurgeItem();
+                    it.Table = tbl; it.Column = col; it.Cycle = cycle; it.Unit = unit;
+                    it.HasWhTyp = (GetVal(c, "HAS_WH") == "1");
+                    lst.Add(it);
+                }
+
+                if (lst.Count == 0) { MakeMsg("[SCH][HIS] 이력 정리 - 대상 표 없음 (DEL_HIS_SETTING)"); return; }
+
+                m_lstPurge = lst;
+                m_dtPurgeBegin = now;
+                PurgeHistoryStep();
+            }
+            catch (Exception ex) { MakeMsg_Error("[SCH][HIS] PurgeHistory 오류: " + ex.Message); m_lstPurge = null; }
+        }
+
+        /// <summary>남은 표 가운데 첫 표에서 한 배치를 지운다. 0건이면 그 표는 끝. 전부 끝나면 요약을 남긴다.</summary>
+        private void PurgeHistoryStep()
+        {
+            try
+            {
+                if (m_lstPurge == null) return;
+                if (m_lstPurge.Count == 0) { PurgeHistoryDone(); return; }
+
+                HisPurgeItem it = m_lstPurge[0];
+                string q = "";
+                q += CRLF + " DELETE TOP (" + HIS_DEL_BATCH + ") FROM " + it.Table;
+                q += CRLF + "  WHERE " + it.Column + " < DATEADD(" + it.Unit + ", -" + it.Cycle + ", " + DbLang.SYSDATE + ") ";
+                if (it.HasWhTyp) q += CRLF + "    AND WH_TYP = :WH_TYP ";
+                _pBdb.mComMain.CommandType = CommandType.Text;
+                _pBdb.mComMain.Parameters.Clear();
+                if (it.HasWhTyp) _pBdb.mComMain.Parameters.Add("WH_TYP", DbLang.VARCHAR).Value = SCH_WH_TYP;
+                int n = DbNonQry(q);
+                if (n < 0) { m_lstPurge.RemoveAt(0); return; }    // 이 표는 포기(오류는 DbErrLog 가 남김) - 다음 표로
+                it.Deleted += n;
+                if (n < HIS_DEL_BATCH)
+                {
+                    // 이 표는 다 지웠다 - 지운 게 있으면 한 줄 남기고 다음 표로
+                    if (it.Deleted > 0)
+                        MakeMsg_Imp(string.Format("[SCH][HIS] {0} : {1} {2} 지난 {3:N0}건 삭제", it.Table, it.Cycle, it.Unit, it.Deleted));
+                    m_lstPurge.RemoveAt(0);
+                    if (m_lstPurge.Count == 0) PurgeHistoryDone();
+                }
+            }
+            catch (Exception ex) { MakeMsg_Error("[SCH][HIS] PurgeHistoryStep 오류: " + ex.Message); m_lstPurge = null; }
+        }
+
+        private void PurgeHistoryDone()
+        {
+            double sec = (DateTime.Now - m_dtPurgeBegin).TotalSeconds;
+            MakeMsg(string.Format("[SCH][HIS] 이력 정리 끝 ({0:F0}초) - 다음 검사 {1:HH:mm}", sec, m_dtNextPurge));
+            m_lstPurge = null;
+        }
+
+        private void PurgeSkipOnce(string tbl, string why)
+        {
+            if (m_setPurgeSkipLogged.Contains(tbl)) return;
+            m_setPurgeSkipLogged.Add(tbl);
+            MakeMsg("[SCH][HIS] " + tbl + " 건너뜀 - " + why);
+        }
+        #endregion
+
         // ─────────────────────────────────────────────────────────────────
         // DB Helper
