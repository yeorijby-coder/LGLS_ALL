[LGV_ERROR_CODE]
  0 = OK
  4 = Position update failed
  7 = Distance error
  8 = Cross wire missing
  9 = Illegal ACE code
 10 = Illegal PTURN
 11 = Illegal table
 12 = Illegal test
 13 = Illegal MOD code
 14 = Illegal BACK
 15 = MOD missing
 16 = Illegal MOD
 26 = Lift trigger
 27 = Lift position
 28 = Lift timeout
 29 = Lift upper limit
 31 = Lift illegal trigger
 41 = Lift K201 test
 42 = Lift K202 test
 49 = Drive power limit
 50 = Steering power limit
 57 = Man drive failure
 58 = Bumper bypass
 60 = AD converter
 62 = Speed ramp
 64 = Charger docking timeout
 65 = Drive connection
 66 = Lift connection
 67 = Steering connection
 68 = Speed
 69 = Steering pot calibration
 70 = Drive wheel pot calibration
 74 = Laser tracking
 76 = Illegal path

