0x00 = OK
0x04 = FILL TAG FAILED
0x05 = READ DATA FAILED
0x06 = WRITE DATA FAILED
0x07 = TAG NOT FOUND, TAG SEARCH FAILED
0x21 = INVALID SYNTAX
0x23 = INVALID TAG TYPE
