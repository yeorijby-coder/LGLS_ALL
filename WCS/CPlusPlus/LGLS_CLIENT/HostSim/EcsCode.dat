[RGV_ERROR_CODE]
   0 = OK
   1 = System Emg Stop Alarm
  11 = BCR Error Alarm
  12 = 범퍼센서 감지 다운
  13 = PLT 이탈
 101 = Load PIO Time Over
 102 = Unload PIO Time Over
 200 = CV Invert Over Load
 201 = RGV Invert Over Load
9101 = RGV CAR Disconnect 상태
9102 = 통신이상
9103 = 작업 DATA 없는데, SENSOR 감지 됨
9104 = RGV 사용안함

[RFID_ERROR_CODE]
0x00 = OK
0x04 = FILL TAG FAILED
0x05 = READ DATA FAILED
0x06 = WRITE DATA FAILED
0x07 = TAG NOT FOUND, TAG SEARCH FAILED
0x21 = INVALID SYNTAX
0x23 = INVALID TAG TYPE
0x30 = INTERNAL CONTROLLER ERROR
0x31 = INVALID CONTROLLER TYPE
0x32 = INVALID PROGRAMMING ADDRESS
0x35 = INVALID RESET
0x36 = SET CONFIGURATION ERROR
0x37 = GET CONfiGURATION ERROR
0x83 = COMMAND INVALID OPCODE
0x84 = COMMAND INVALID PARAMETER
0x85 = COMMAND INVALID CONTROLLER ID
0x86 = COMMAND INACTIVE CONTROLLER ID
0x87 = SUBNET DEVICE SELECT FAILED
0x88 = SUBNET DEVICE FAILED TO ACKNOWLEDGE
0x89 = SUBNET RESPONSE NALFORMED
0x8A = SUBNET RESPONSE TIMEOUT
0x8B = SUBNET RESPONSE INVALID CHECKSUM
0x8C = SUBNET DEVICE CONFLICT DETECTED
0x8D = BUFFER OVERFLOW
0x8E = FLASH FAILURE
0x92 = SUBNET16 ONLY COMMAND
0x93 = NODE MISMATCH ERROR
0x94 = CRC ERROR
0x95 = PROTOCOL ERROR
0xF1 = 수신 메시지 길이 이상
0xF2 = 작업정보 이상
0xF3 = BIDP ID 불일치
0xFE = 통신이상
0xFF = 통신두절

[BCR_ERROR_CODE]
0 = 정상
1 = 수신메시지 길이 이상
2 = STX 이상
3 = ETX 이상
4 = BARCODE 이상
5 = NOREAD
6 = 작업정보 이상
7 = BARCODE 불일치
8 = 통신이상
9 = 통신두절

[DSP_ERROR_CODE]
0 = 정상
1 = 응답메시지 길이 이상
2 = 응답메시지 STX 이상
3 = 응답메시지 ETX 이상
4 = ID 이상
5 = ACK 이상
6 = 통신이상
7 = 통신두절
