[LGV_ERROR_CODE]
  0 = OK
  4 = Position update failed
  7 = Distance error
  8 = Cross wire missing
  9 = Illegal ACE code
 10 = Illegal PTURN
 11 = Illegal table
 12 = Illegal test
 13 = Illegal MOD code
 14 = Illegal BACK
 15 = MOD missing
 16 = Illegal MOD
 26 = Lift trigger
 27 = Lift position
 28 = Lift timeout
 29 = Lift upper limit
 31 = Lift illegal trigger
 41 = Lift K201 test
 42 = Lift K202 test
 49 = Drive power limit
 50 = Steering power limit
 57 = Man drive failure
 58 = Bumper bypass
 60 = AD converter
 62 = Speed ramp
 64 = Charger docking timeout
 65 = Drive connection
 66 = Lift connection
 67 = Steering connection
 68 = Speed
 69 = Steering pot calibration
 70 = Drive wheel pot calibration
 74 = Laser tracking
 76 = Illegal path

[RFID_ERROR_CODE]
0x00 = OK
0x04 = FILL TAG FAILED
0x05 = READ DATA FAILED
0x06 = WRITE DATA FAILED
0x07 = TAG NOT FOUND, TAG SEARCH FAILED
0x21 = INVALID SYNTAX
0x23 = INVALID TAG TYPE
0x30 = INTERNAL CONTROLLER ERROR
0x31 = INVALID CONTROLLER TYPE
0x32 = INVALID PROGRAMMING ADDRESS
0x35 = INVALID RESET
0x36 = SET CONFIGURATION ERROR
0x37 = GET CONfiGURATION ERROR
0x83 = COMMAND INVALID OPCODE
0x84 = COMMAND INVALID PARAMETER
0x85 = COMMAND INVALID CONTROLLER ID
0x86 = COMMAND INACTIVE CONTROLLER ID
0x87 = SUBNET DEVICE SELECT FAILED
0x88 = SUBNET DEVICE FAILED TO ACKNOWLEDGE
0x89 = SUBNET RESPONSE NALFORMED
0x8A = SUBNET RESPONSE TIMEOUT
0x8B = SUBNET RESPONSE INVALID CHECKSUM
0x8C = SUBNET DEVICE CONFLICT DETECTED
0x8D = BUFFER OVERFLOW
0x8E = FLASH FAILURE
0x92 = SUBNET16 ONLY COMMAND
0x93 = NODE MISMATCH ERROR
0x94 = CRC ERROR
0x95 = PROTOCOL ERROR
0xF1 = 수신 메시지 길이 이상
0xF2 = 작업정보 이상
0xF3 = BIDP ID 불일치
0xFE = 통신이상
0xFF = 통신두절

[BCR_ERROR_CODE]
0 = 정상
1 = 수신메시지 길이 이상
2 = STX 이상
3 = ETX 이상
4 = BARCODE 이상
5 = NOREAD
6 = 작업정보 이상
7 = BARCODE 불일치
8 = 통신이상
9 = 통신두절

[DSP_ERROR_CODE]
0 = 정상
1 = 응답메시지 길이 이상
2 = 응답메시지 STX 이상
3 = 응답메시지 ETX 이상
4 = ID 이상
5 = ACK 이상
6 = 통신이상
7 = 통신두절
