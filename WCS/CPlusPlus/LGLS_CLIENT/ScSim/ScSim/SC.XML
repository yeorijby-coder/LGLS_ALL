	<SC TYPE="0" class="CSc" number="1" device="SC_E01" cid="1112029001" com="E" desc="Number는 순차적이어야 함-레지스트리를 이값에 인덱스로 사용함!-CID를 맞춰서 가져가야함!">
		<HS_GROUP>
			<!--
				입고 H/S <HS> : DEL_ADDR  = 입고(로딩) 완료후 지울 CV 트랙 데이터 시작주소(D)
				                DEL_CNT   = 지울 워드 개수
				                PROD_ADDR = 입고(로딩) 완료후 화물감지 워드 주소 (0 쓰기 = 삭제)
				출고 H/S <HS> : PROD_ADDR = 출고(언로딩) 완료후 화물감지 워드 주소 (1 쓰기 = 감지)
				PAIR 트랙     : DEL_ADDR2 / DEL_CNT2 / PROD_ADDR2 (포크#2)
				속성이 없으면 기존 계산식으로 동작
				CvSim 5워드맵 : 기본주소 = (트랙번호 - 첫트랙번호 + 1) * 5, 화물감지 = 기본주소 + 2
			-->
			<STO_HS>
				<HS NO="1"  TID="6"   CV_PLC_NO="1" PAIR="0" BANK="2" BAY="12"  LEVEL="0" DEL_ADDR="30" DEL_CNT="5" PROD_ADDR="32"/>
				<HS NO="3"  TID="2"   CV_PLC_NO="1" PAIR="0" BANK="2" BAY="15"  LEVEL="0" DEL_ADDR="10" DEL_CNT="5" PROD_ADDR="12"/>
