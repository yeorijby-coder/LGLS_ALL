/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "시스템(&S)"
    BEGIN
        MENUITEM "환경 설정(&C)",                   ID_SYSTEM_CONFIG1
        MENUITEM "사용자 관리(&U)",                  ID_SYS_USER_MANAGER
        MENUITEM "ECS 제어창(&E)",                 ID_SYS_CONTROL
        MENUITEM SEPARATOR
        MENUITEM "종료(&E)",                      ID_APP_EXIT
    END
    POPUP "작업(&J)"
    BEGIN
        MENUITEM "작업정보 관리(&J)",                 ID_JOB_MANAGER
        MENUITEM "반자동 작업(&O)",                  ID_JOB_OFFLINE
    END
    POPUP "로그(&L)"
    BEGIN
        MENUITEM "로그 관리(&L)",                   ID_LOG_ALL
        MENUITEM "알람 관리(&A)",                   ID_WARNING
    END
    POPUP "보기(&V)"
    BEGIN
        MENUITEM "도구 모음(&T)",                   ID_VIEW_TOOLBAR
        MENUITEM "상태 표시줄(&S)",                  ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "LAYOUT 정보(&L)",               ID_VIEW_LAYOUT_INFO
        MENUITEM SEPARATOR
        MENUITEM "모든 설비 정지(&P)",                ID_SET_ALL_SUSPEND
        MENUITEM "모든 설비 정지 해제(&A)",             ID_UNSET_ALL_SUSPEND
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "Ecs 정보(&A)...",               ID_APP_ABOUT
    END
END

IDR_LOGGING MENU
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "열기(&O)...\tCtrl+O",           ID_LOG_FILE
        MENUITEM "다른 이름으로 저장(&A)...",           ID_LOG_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "종료(&X)",                      ID_LOG_EXIT
    END
    MENUITEM "최신정보(&R)",                    ID_REFRESH_LOG
END


