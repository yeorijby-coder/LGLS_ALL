<Window x:Class="FTPServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECS FTP Server" Width="700" Height="500"
        Closing="Window_Closing">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#FF003366" Height="34">
            <TextBlock Text="ECS FTP Server" Foreground="White" FontSize="13" FontWeight="Bold"
                       FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="10,0"/>
        </DockPanel>

        <!-- 설정 바 -->
        <Grid DockPanel.Dock="Top" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="포트:"/>
            <TextBox Grid.Column="1" x:Name="TxtPort" Text="21"/>
            <Label Grid.Column="2" Content="루트 경로:" Margin="8,0,0,0"/>
            <TextBox Grid.Column="3" x:Name="TxtRoot" Text="C:\EcsFtp"/>
            <Button Grid.Column="4" Content="시작" Click="BtnStart_Click" Margin="8,0,0,0"/>
            <Button Grid.Column="5" Content="중지" Click="BtnStop_Click" Margin="4,0,0,0"/>
        </Grid>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtStatus" Text="중지됨"/>
            <Separator/>
            <TextBlock x:Name="TxtConnCount" Text="연결: 0"/>
        </StatusBar>

        <!-- 로그 -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="4,0">
                <TextBlock Text="서버 로그" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="지우기" HorizontalAlignment="Right" Click="BtnClearLog_Click" Margin="4,0"/>
            </DockPanel>
            <ListBox x:Name="LogBox" FontFamily="Consolas" FontSize="11" Margin="4"/>
        </DockPanel>
    </DockPanel>
</Window>
