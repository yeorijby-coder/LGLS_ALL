<Window x:Class="Ecs.Views.FindDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="찾기"
        Width="480" Height="440"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="12"
        Background="#FF0D1B2A">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFDDE8F0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="3"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="찾기 (C++ CViewSearchDlg 대응) — 트랙/컨트롤 ID·라벨 검색" FontSize="13" FontWeight="Bold" Foreground="#FF00AAFF" Margin="0,0,0,10"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="검색어:" Width="60"/>
            <TextBox x:Name="TxtQuery" Width="220" Height="26" VerticalContentAlignment="Center"/>
            <Button Content="찾기" Click="BtnFind_Click" Background="#FF1E5A2E" Foreground="White"/>
        </StackPanel>
        <ListView Grid.Row="2" x:Name="LstResult" Margin="0,10" Background="#FF071018" Foreground="#FFCFE6FF" BorderBrush="#FF223344">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="종류" Width="110" DisplayMemberBinding="{Binding Kind}"/>
                    <GridViewColumn Header="ID" Width="110" DisplayMemberBinding="{Binding Id}"/>
                    <GridViewColumn Header="라벨/텍스트" Width="200" DisplayMemberBinding="{Binding Text}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="TxtCount" Text="0건" Margin="0,0,16,0"/>
            <Button Content="닫기" Click="BtnClose_Click" Width="70"/>
        </StackPanel>
    </Grid>
</Window>
