<Window x:Class="Ecs.Views.SemiTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="반자동 TEST"
        Width="620" Height="540"
        WindowStartupLocation="CenterOwner"
        FontFamily="Malgun Gothic" FontSize="12"
        Background="#FF0D1B2A">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFDDE8F0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="3"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="반자동 TEST (C++ CSemiTestDlg 대응)" FontSize="14" FontWeight="Bold"
                   Foreground="#FF00AAFF" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="HOST 없이 입고↔출고 사이클을 자동 반복하여 작업 파이프라인을 검증합니다."
                   Foreground="#FF88AACC" FontSize="11" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="라인 수:" Width="60"/>
            <TextBox x:Name="TxtRows" Text="5" Width="50" Height="24"/>
            <TextBlock Text="  주기(ms):" Width="70"/>
            <TextBox x:Name="TxtInterval" Text="800" Width="60" Height="24"/>
            <Button x:Name="BtnStart" Content="시작" Click="BtnStart_Click" Background="#FF1E5A2E" Foreground="White"/>
            <Button x:Name="BtnStop"  Content="정지" Click="BtnStop_Click"  Background="#FF6A2E2E" Foreground="White"/>
            <Button x:Name="BtnClearLog" Content="로그 지우기" Click="BtnClearLog_Click"/>
        </StackPanel>

        <ListView Grid.Row="3" x:Name="LstLog" Margin="0,10" Background="#FF071018" Foreground="#FFCFE6FF"
                  BorderBrush="#FF223344" FontFamily="Consolas" FontSize="11">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="시각" Width="90" DisplayMemberBinding="{Binding Time}"/>
                    <GridViewColumn Header="라인" Width="45" DisplayMemberBinding="{Binding Row}"/>
                    <GridViewColumn Header="동작" Width="70" DisplayMemberBinding="{Binding Act}"/>
                    <GridViewColumn Header="작업번호" Width="70" DisplayMemberBinding="{Binding Lugg}"/>
                    <GridViewColumn Header="내용" Width="300" DisplayMemberBinding="{Binding Msg}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="TxtStat" Text="정지됨" FontWeight="Bold" Margin="0,0,16,0"/>
            <Button Content="닫기" Click="BtnClose_Click" Width="70"/>
        </StackPanel>
    </Grid>
</Window>
