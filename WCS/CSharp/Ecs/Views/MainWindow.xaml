<Window x:Class="Ecs.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ecs.Views"
        Title="ECS - Equipment Control System"
        Width="1400" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowState="Maximized"
        Background="#FF0A0A1A"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- 툴바 버튼 스타일 -->
        <Style x:Key="TbBtnStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="#FF2A3A4A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF445566"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A5A7A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF1A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 통신 상태 LED 스타일 -->
        <Style x:Key="CommLedStyle" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 상태바 텍스트 스타일 -->
        <Style x:Key="SbTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ══════════════════════════════════════════════════════
             1. 로고 타이틀 바
             ══════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="44" Background="#FF002244">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0">
                    <TextBlock Text="■" Foreground="#FF00AAFF" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="ECS" Foreground="White" FontSize="18" FontWeight="Bold"
                               FontFamily="Malgun Gothic" VerticalAlignment="Center"/>
                    <TextBlock Text="  Equipment Control System" Foreground="#FFAACCEE"
                               FontSize="13" FontFamily="Malgun Gothic" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtClock" Grid.Column="2"
                           Foreground="#FFAACCEE" FontSize="13" FontFamily="Malgun Gothic"
                           VerticalAlignment="Center" Margin="12,0"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             2. 메뉴 바  (SKI IDR_MAINFRAME MENU 대응)
             ══════════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top" Background="#FF001833" FontFamily="Malgun Gothic" FontSize="12">
            <Menu.ItemContainerStyle>
                <Style TargetType="MenuItem">
                    <Setter Property="FontFamily" Value="Malgun Gothic"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF001833"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#FF003366"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter Property="Background" Value="#FF003366"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.ItemContainerStyle>
            <MenuItem Header="시스템(_S)">
                <MenuItem Header="환경 설정(_C)..."     Click="Menu_Config_Click"/>
                <MenuItem Header="온라인(_O)"           Click="BtnOnline_Click"/>
                <MenuItem Header="오프라인(_F)"         Click="BtnOffline_Click"/>
                <Separator/>
                <MenuItem Header="Host 연결(_H)"        Click="Menu_HostConnect_Click"/>
                <Separator/>
                <MenuItem Header="종료(_X)"             Click="Menu_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="장비(_E)">
                <MenuItem Header="장비 시작(_S)"        Click="BtnStart_Click"/>
                <MenuItem Header="장비 중지(_P)"        Click="BtnStop_Click"/>
                <MenuItem Header="일시 정지(_U)"        Click="BtnPause_Click"/>
                <Separator/>
                <MenuItem Header="모든 설비 정지(_A)"   Click="Menu_SuspendAll_Click"/>
                <MenuItem Header="모든 설비 정지 해제(_R)" Click="Menu_ResumeAll_Click"/>
            </MenuItem>
            <MenuItem Header="작업(_J)">
                <MenuItem Header="작업정보 관리(_M)..."  Click="Menu_JobManager_Click"/>
                <MenuItem Header="반자동 작업(_O)..."   Click="Menu_JobOffline_Click"/>
                <Separator/>
                <MenuItem Header="작업정보 초기화(_R)"  Click="Menu_ClearJobs_Click"/>
                <MenuItem Header="작업 백업(_B)"        Click="BtnBackup_Click"/>
            </MenuItem>
            <MenuItem Header="로그(_L)">
                <MenuItem Header="로그 관리(_A)..."     Click="Menu_LogAll_Click"/>
                <MenuItem Header="알람 관리(_W)"        Click="Menu_Warning_Click"/>
                <Separator/>
                <MenuItem Header="로그 지우기(_C)"      Click="Menu_ClearLog_Click"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="레이아웃 1(_1)"       Click="Menu_Layout1_Click"/>
                <MenuItem Header="레이아웃 2(_2)"       Click="Menu_Layout2_Click"/>
                <MenuItem Header="레이아웃 3(_3)"       Click="Menu_Layout3_Click"/>
                <Separator/>
                <MenuItem Header="Job 목록(_J)"         Click="Menu_JobList_Click"/>
                <MenuItem Header="로그(_L)"             Click="Menu_LogTab_Click"/>
                <Separator/>
                <MenuItem Header="LAYOUT 정보(_I)"      Click="Menu_LayoutInfo_Click"/>
                <MenuItem Header="설비 범례(_Q)"        Click="Menu_EquipLegend_Click"/>
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="ECS 정보(_A)..."      Click="Menu_About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ══════════════════════════════════════════════════════
             3. 툴바 (운영 버튼) — SKI IDR_TOOLBAR0 대응
             ══════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="36" Background="#FF0D1B2A"
                BorderBrush="#FF1A2A3A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                <Button Style="{StaticResource TbBtnStyle}" Content="⚙ 설정"
                        ToolTip="환경 설정" Click="Menu_Config_Click"/>
                <Rectangle Fill="#FF334455" Width="1" Margin="4,4"/>
                <Button x:Name="BtnOnline"  Style="{StaticResource TbBtnStyle}"
                        Content="● 온라인"  Foreground="#FF90EE90" ToolTip="온라인 전환"
                        Click="BtnOnline_Click"/>
                <Button x:Name="BtnOffline" Style="{StaticResource TbBtnStyle}"
                        Content="○ 오프라인" Foreground="#FFAAAAAA" ToolTip="오프라인 전환"
                        Click="BtnOffline_Click"/>
                <Rectangle Fill="#FF334455" Width="1" Margin="4,4"/>
                <Button x:Name="BtnStart"  Style="{StaticResource TbBtnStyle}"
                        Content="▶ 시작"  Foreground="#FF90EE90" ToolTip="장비 시작"
                        Click="BtnStart_Click"/>
                <Button x:Name="BtnStop"   Style="{StaticResource TbBtnStyle}"
                        Content="■ 중지"  Foreground="#FFFF6464" ToolTip="장비 중지"
                        Click="BtnStop_Click"/>
                <Button x:Name="BtnPause"  Style="{StaticResource TbBtnStyle}"
                        Content="⏸ 정지" Foreground="#FFFFD700" ToolTip="일시 정지 / 재개"
                        Click="BtnPause_Click"/>
                <Rectangle Fill="#FF334455" Width="1" Margin="4,4"/>
                <Button Style="{StaticResource TbBtnStyle}" Content="📋 작업관리"
                        ToolTip="작업정보 관리" Click="Menu_JobManager_Click"/>
                <Button Style="{StaticResource TbBtnStyle}" Content="💾 백업"
                        ToolTip="Job 백업" Click="BtnBackup_Click"/>
                <Rectangle Fill="#FF334455" Width="1" Margin="4,4"/>
                <Button Style="{StaticResource TbBtnStyle}" Content="📄 로그"
                        ToolTip="로그 관리" Click="Menu_LogAll_Click"/>
                <Rectangle Fill="#FF334455" Width="1" Margin="4,4"/>
                <Button Style="{StaticResource TbBtnStyle}" Content="✕ 종료"
                        Foreground="#FFFF9966" ToolTip="프로그램 종료"
                        Click="Menu_Exit_Click"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             4. 통신 상태 표시줄 — SKI IDR_TOOLBAR1 대응
                HOST / CV / SC / RTV / BCR 연결 상태 LED 표시
             ══════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="26" Background="#FF070F18"
                BorderBrush="#FF1A2A3A" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="통신:" Foreground="#FF6688AA" FontSize="10"
                           FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedHost" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedHost" Text="HOST" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedCv1" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedCv1" Text="CV01" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedSc1" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedSc1" Text="SC#1" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedSc2" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedSc2" Text="SC#2" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedSc3" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedSc3" Text="SC#3" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedSc4" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedSc4" Text="SC#4" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedRtv1" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedRtv1" Text="RTV1" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedRtv2" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedRtv2" Text="RTV2" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedBcr1" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedBcr1" Text="BCR1" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border Style="{StaticResource CommLedStyle}" x:Name="LedBcr2" Background="#FF555555"/>
                <TextBlock x:Name="TxtLedBcr2" Text="BCR2" Foreground="#FF6688AA"
                           FontSize="10" FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Rectangle Fill="#FF334455" Width="1" Margin="4,4"/>
                <TextBlock Text="알람:" Foreground="#FF6688AA" FontSize="10"
                           FontFamily="Malgun Gothic" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAlarmCnt" Text="0" Foreground="#FFFF6464"
                           FontSize="10" FontFamily="Malgun Gothic" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             5. 하단 상태 표시줄
             ══════════════════════════════════════════════════════ -->
        <StatusBar DockPanel.Dock="Bottom" Height="24" Background="#FF070F18">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtMode" Text="[OFFLINE]"
                               Foreground="#FF90EE90" Style="{StaticResource SbTextStyle}"/>
                    <Rectangle Fill="#FF334455" Width="1" Margin="0,4"/>
                    <TextBlock x:Name="TxtCtrl" Text="[INIT]"
                               Foreground="Yellow" Style="{StaticResource SbTextStyle}"/>
                    <Rectangle Fill="#FF334455" Width="1" Margin="0,4"/>
                    <TextBlock x:Name="TxtJobCnt" Text="Job: 0"
                               Foreground="White" Style="{StaticResource SbTextStyle}"/>
                    <Rectangle Fill="#FF334455" Width="1" Margin="0,4"/>
                    <TextBlock x:Name="TxtStatus" Text="준비"
                               Foreground="White" Style="{StaticResource SbTextStyle}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ══════════════════════════════════════════════════════
             6. 메인 영역 — 레이아웃 탭 + 우측 도킹 패널
             ══════════════════════════════════════════════════════ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- 레이아웃 탭 -->
            <TabControl Grid.Column="0" x:Name="TabLayout"
                        Background="#FF0A0A1A" BorderBrush="#FF223344">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontFamily" Value="Malgun Gothic"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="#FFAACCEE"/>
                        <Setter Property="Background" Value="#FF0D1B2A"/>
                        <Setter Property="Padding" Value="12,4"/>
                    </Style>
                </TabControl.Resources>
                <TabItem Header="레이아웃 1">
                    <views:EcsLayoutView x:Name="LayoutView1" LayoutIndex="0"/>
                </TabItem>
                <TabItem Header="레이아웃 2">
                    <views:EcsLayoutView x:Name="LayoutView2" LayoutIndex="1"/>
                </TabItem>
                <TabItem Header="레이아웃 3">
                    <views:EcsLayoutView x:Name="LayoutView3" LayoutIndex="2"/>
                </TabItem>
                <TabItem Header="로그">
                    <views:LogView x:Name="LogView"/>
                </TabItem>
                <TabItem Header="Job 목록">
                    <views:JobListView x:Name="JobListView"/>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="#FF1A2A3A"/>

            <!-- 우측 패널 -->
            <Grid Grid.Column="2" Background="#FF080E18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="180" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- 장비 상태 패널 (SKI CPanelInfoDlg 대응) -->
                <Border Grid.Row="0" BorderBrush="#FF223344" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FF002244" Height="24">
                            <TextBlock Text="장비 상태" Foreground="White" FontWeight="Bold"
                                       FontSize="12" FontFamily="Malgun Gothic"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF080E18">
                            <views:EquipmentStatusPanel x:Name="EqStatusPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              Background="#FF1A2A3A"/>

                <!-- 대기 Job 패널 (SKI CPanelJobDlg 대응) -->
                <Border Grid.Row="2" BorderBrush="#FF223344" BorderThickness="1">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#FF002244" Height="24">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="대기 Job" Foreground="White" FontWeight="Bold"
                                           FontSize="12" FontFamily="Malgun Gothic"
                                           VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock x:Name="TxtJobCnt2" Text="(0)" Foreground="#FFAACCEE"
                                           FontSize="11" FontFamily="Malgun Gothic"
                                           VerticalAlignment="Center" Margin="4,0"/>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="LvJobMini" Background="#FF080E18"
                                  BorderThickness="0" Foreground="White"
                                  FontFamily="Malgun Gothic" FontSize="10">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="번호"  Width="50"
                                                    DisplayMemberBinding="{Binding LuggNum}"/>
                                    <GridViewColumn Header="상태"  Width="55"
                                                    DisplayMemberBinding="{Binding Status}"/>
                                    <GridViewColumn Header="유형"  Width="55"
                                                    DisplayMemberBinding="{Binding JobType}"/>
                                    <GridViewColumn Header="출발"  Width="60"
                                                    DisplayMemberBinding="{Binding FromStation}"/>
                                    <GridViewColumn Header="도착"  Width="60"
                                                    DisplayMemberBinding="{Binding ToStation}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
