<Application x:Class="Ecs.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- 전역 스타일 -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Malgun Gothic"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- 상태 색상 -->
        <SolidColorBrush x:Key="NormalBrush"   Color="#FF90EE90"/>
        <SolidColorBrush x:Key="FaultBrush"    Color="#FFFF6464"/>
        <SolidColorBrush x:Key="PmBrush"       Color="#FFFFD700"/>
        <SolidColorBrush x:Key="OfflineBrush"  Color="#FFC0C0C0"/>
        <SolidColorBrush x:Key="HeaderBrush"   Color="#FF003366"/>
        <SolidColorBrush x:Key="HeaderFgBrush" Color="White"/>
    </Application.Resources>
</Application>
