<Window x:Class="Builder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECS Layout Builder" Width="1200" Height="800">
    <DockPanel>
        <!-- 메뉴바 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="새로 만들기" Click="MenuNew_Click"/>
                <MenuItem Header="열기(_O)..."  Click="MenuOpen_Click"/>
                <MenuItem Header="저장(_S)"     Click="MenuSave_Click"/>
                <MenuItem Header="다른 이름으로 저장..." Click="MenuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="종료(_X)"     Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="실행취소" Click="MenuUndo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="다시실행" Click="MenuRedo_Click" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="삭제" Click="MenuDelete_Click" InputGestureText="Del"/>
            </MenuItem>
            <MenuItem Header="컨트롤(_C)">
                <MenuItem Header="Static"  Click="MenuAddStatic_Click"/>
                <MenuItem Header="Button"  Click="MenuAddButton_Click"/>
                <MenuItem Header="Track"   Click="MenuAddTrack_Click"/>
                <MenuItem Header="Rack"    Click="MenuAddRack_Click"/>
                <MenuItem Header="RV(RTV)" Click="MenuAddRv_Click"/>
                <MenuItem Header="Lifter"  Click="MenuAddLifter_Click"/>
                <MenuItem Header="OpBox"   Click="MenuAddOpbox_Click"/>
            </MenuItem>
        </Menu>

        <!-- 툴바 -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="열기"  Click="MenuOpen_Click"/>
            <Button Content="저장"  Click="MenuSave_Click"/>
            <Separator/>
            <Button Content="Static" Click="MenuAddStatic_Click"/>
            <Button Content="Track"  Click="MenuAddTrack_Click"/>
            <Button Content="Rack"   Click="MenuAddRack_Click"/>
            <Button Content="RTV"    Click="MenuAddRv_Click"/>
            <Separator/>
            <Button Content="삭제" Click="MenuDelete_Click"/>
        </ToolBar>

        <!-- 상태바 -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtStatus" Text="준비"/>
            <Separator/>
            <TextBlock x:Name="TxtPos" Text=""/>
        </StatusBar>

        <!-- 메인 분할 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 그룹/컨트롤 트리 -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="컨트롤 목록" FontWeight="Bold"
                           Background="DarkSlateGray" Foreground="White" Padding="4,2"/>
                <TreeView x:Name="CtrlTree" SelectedItemChanged="CtrlTree_SelectionChanged"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <!-- 가운데: 편집 캔버스 -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1"
                    Background="#FF1A1A2E" ClipToBounds="True">
                <Canvas x:Name="EditCanvas"
                        MouseMove="EditCanvas_MouseMove"
                        MouseDown="EditCanvas_MouseDown"
                        MouseUp="EditCanvas_MouseUp"
                        Focusable="True"/>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

            <!-- 우측: 속성 편집기 -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="속성" FontWeight="Bold"
                           Background="DarkSlateGray" Foreground="White" Padding="4,2"/>
                <ScrollViewer>
                    <Grid x:Name="PropGrid" Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="ID"/>
                        <TextBox x:Name="PropId"      Grid.Row="0" Grid.Column="1" IsReadOnly="True"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="텍스트"/>
                        <TextBox x:Name="PropText"    Grid.Row="1" Grid.Column="1" TextChanged="Prop_Changed"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="L"/>
                        <TextBox x:Name="PropL"       Grid.Row="2" Grid.Column="1" TextChanged="Prop_Changed"/>
                        <Label Grid.Row="3" Grid.Column="0" Content="B"/>
                        <TextBox x:Name="PropB"       Grid.Row="3" Grid.Column="1" TextChanged="Prop_Changed"/>
                        <Label Grid.Row="4" Grid.Column="0" Content="R"/>
                        <TextBox x:Name="PropR"       Grid.Row="4" Grid.Column="1" TextChanged="Prop_Changed"/>
                        <Label Grid.Row="5" Grid.Column="0" Content="T"/>
                        <TextBox x:Name="PropT"       Grid.Row="5" Grid.Column="1" TextChanged="Prop_Changed"/>
                        <Label Grid.Row="6" Grid.Column="0" Content="BG색"/>
                        <TextBox x:Name="PropBgColor" Grid.Row="6" Grid.Column="1" TextChanged="Prop_Changed"/>
                        <Label Grid.Row="7" Grid.Column="0" Content="FG색"/>
                        <TextBox x:Name="PropFgColor" Grid.Row="7" Grid.Column="1" TextChanged="Prop_Changed"/>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
