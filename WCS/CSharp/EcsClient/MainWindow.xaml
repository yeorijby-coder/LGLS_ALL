<Window x:Class="EcsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ECS Client - 원격 모니터" Width="1024" Height="700">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#FF003366" Height="34">
            <TextBlock Text="ECS Client  원격 모니터링"
                       Foreground="White" FontSize="13" FontWeight="Bold"
                       FontFamily="Malgun Gothic" VerticalAlignment="Center" Margin="10,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="서버:" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="TxtServer" Text="127.0.0.1" Width="120" VerticalAlignment="Center"/>
                <TextBlock Text="포트:" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox x:Name="TxtPort" Text="9001" Width="60" VerticalAlignment="Center"/>
                <Button Content="연결" Click="BtnConnect_Click" Margin="4,0"/>
                <Button Content="연결해제" Click="BtnDisconnect_Click" Margin="2,0"/>
            </StackPanel>
        </DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtConnStatus" Text="연결 안됨" Foreground="Gray"/>
        </StatusBar>
        <TabControl>
            <TabItem Header="레이아웃">
                <Border Background="#FF1A1A2E">
                    <Canvas x:Name="LayoutCanvas" Background="Transparent"
                            SizeChanged="LayoutCanvas_SizeChanged"/>
                </Border>
            </TabItem>
            <TabItem Header="장비 상태">
                <ListView x:Name="EqListView" FontSize="11">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="장비"   Width="120" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="종류"   Width="80"  DisplayMemberBinding="{Binding Kind}"/>
                            <GridViewColumn Header="상태"   Width="80"  DisplayMemberBinding="{Binding State}"/>
                            <GridViewColumn Header="정보"   Width="200" DisplayMemberBinding="{Binding Info}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
