+			{
+				if (r.LocalPort != pPort || r.Pid != myPid) continue;
+				if (r.State == STATE_LISTEN) nL++;
+				else if (r.State == STATE_CLOSE_WAIT) nC++;
+				else nO++;
+			}
+			if (nL + nC + nO == 0) return "";
+			StringBuilder sb = new StringBuilder();
+			if (nL > 0) sb.Append("LISTENING " + nL + "건 ");
+			if (nC > 0) sb.Append("CLOSE_WAIT " + nC + "건 ");
+			if (nO > 0) sb.Append("그 밖 " + nO + "건");
+			string nm = "";
+			try { nm = Process.GetCurrentProcess().ProcessName; } catch { }
+			return "PID " + myPid + "  " + nm + "  (" + sb.ToString().Trim() + ")";
+		}
