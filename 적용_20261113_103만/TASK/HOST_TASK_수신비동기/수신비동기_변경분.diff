+		private RxResult WaitFrame(Socket s, int pTimeoutSec, out string pWhy)
+		{
+			pWhy = "";
+			DateTime tmEnd = DateTime.Now.AddSeconds(pTimeoutSec);
+
+			lock (m_rxLock)
+			{
+				while (true)
+				{
+					if (m_rxLen >= modDefApp.MSG_HEAD_CNT)
+					{
+						int iBody = 0;
+						try { iBody = Convert.ToInt32(System.Text.Encoding.UTF8.GetString(m_rxQ, 10, 4)); }
+						catch { pWhy = "헤더의 정보가 틀립니다."; return RxResult.Invalid; }
+
+						if (iBody < 3)
+						{
+							pWhy = string.Format("Body의 길이가 '3' 이하 입니다.[Leng={0}]", iBody);
+							return RxResult.Invalid;
+						}
+						if (modDefApp.MSG_HEAD_CNT + iBody > m_bytRxBuff.Length)
+						{
+							pWhy = string.Format("Body의 길이가 허용 범위를 넘었습니다.[Leng={0}]", iBody);
