+++ b/CCliAsync.cs
@@ -0,0 +1,282 @@
+﻿using System;
+using System.Net.Sockets;
+using System.Threading;
+
+namespace TSK_HostCom
+{
+	// [LGLS 2026-11-16] ★송신(상위로 나가는 접속) 비동기 전환★ (사용자 지시 - 구 ECP 의 tcpClient 와 같은 방식).
+	//   종전: Send 가 블로킹이고, 응답은 Available 을 10ms 마다 들여다보다(CheckRecvSock) 블로킹 Receive 로 읽었다.
+	//         접속이 유휴인 동안은 아무도 소켓을 읽지 않아, 상대(WMS)가 끊어도 다음에 보낼 때까지 모르고
+	//         우리 쪽 소켓이 CLOSE_WAIT 로 남았다.
+	//   지금: ① 접속하면 BeginReceive 를 항상 걸어 둔다(수신 펌프). 상대가 끊으면 바로 알아채 소켓을 닫고
+	//           다음 주기(3초)에 다시 접속한다. ② 송신은 BeginSend + 시간 제한(5초)이고 종료 요청이면 즉시 중단한다.
+	//         ③ 응답은 펌프가 모은 바이트에서 전문 하나가 완성될 때까지 기다린다(쪼개져 와도 된다).
+	//   ini [Host] CLI_ASYNC=0 이면 종전 경로(RequestSrv 의 동기 방식)로 돈다. 기본 1.
+	//   전문 조립(GetStatusReport 등)과 응답 처리 문구는 그대로다.
+	partial class CCliWork
+	{
+		private const int SEND_TIMEOUT_MS = 5000;
+
+		internal static bool CliAsync
+		{
+			get
+			{
+				try
+				{
+					string strIni = System.IO.Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "EcsComA.ini");
+					return modDefAPI.GetPrivateProfileInt("Host", "CLI_ASYNC", 1, strIni) != 0;
+				}
+				catch { return true; }
+			}
+		}
+
+		private bool m_blPump;										// 이 접속은 수신 펌프가 돈다
+		private readonly object m_rxLock = new object();
+		private byte[] m_rxQ = new byte[8192];						// 펌프가 모은 수신 바이트
+		private int m_rxLen;
+
+		private class CliRxState
+		{
+			public Socket S;
+			public byte[] B;
+		}
+
+		private enum RxResult { Ok, Timeout, Closed, Invalid }
+
+		// 접속 직후 : 수신 펌프를 시작한다
+		private void StartRxPump()
+		{
+			m_blPump = CliAsync;
+			if (!m_blPump) return;
+			lock (m_rxLock) { m_rxLen = 0; }
+			ArmRx(m_sktSock);
+		}
+
+		private void ArmRx(Socket s)
+		{
+			if (s == null) return;
+			try
+			{
+				CliRxState st = new CliRxState();
+				st.S = s;
+				st.B = new byte[2048];
+				s.BeginReceive(st.B, 0, st.B.Length, SocketFlags.None, new AsyncCallback(OnCliRx), st);
+			}
+			catch (ObjectDisposedException) { }
+			catch (SocketException se) { PumpClosed(s, "수신 대기 실패(" + se.ErrorCode + ")"); }
+			catch (Exception) { }
+		}
+
+		private void OnCliRx(IAsyncResult ar)
+		{
+			CliRxState st = (CliRxState)ar.AsyncState;
+			int n = 0;
+			try
+			{
+				n = st.S.EndReceive(ar);
+			}
+			catch (ObjectDisposedException) { return; }					// 우리가 닫았다
+			catch (SocketException se)
+			{
+				PumpClosed(st.S, "수신 오류(" + se.ErrorCode + ")");
+				return;
+			}
+			catch (Exception) { return; }
+
+			if (n <= 0)
+			{
+				PumpClosed(st.S, "상대가 연결을 끊음");
+				return;
+			}
+
+			lock (m_rxLock)
+			{
+				if (m_rxLen + n > m_rxQ.Length) m_rxLen = 0;			// 요청 없이 쌓인 데이터가 너무 많으면 버린다
+				Buffer.BlockCopy(st.B, 0, m_rxQ, m_rxLen, n);
+				m_rxLen += n;
+				Monitor.PulseAll(m_rxLock);
+			}
+
+			if (ReferenceEquals(m_sktSock, st.S)) ArmRx(st.S);
+		}
+
+		// 상대가 끊었거나 수신 오류 : 이 소켓을 닫고, 아직 현재 접속이면 끊김 상태로 돌린다(재접속은 클라이언트 스레드가 3초 주기로)
+		private void PumpClosed(Socket s, string pWhy)
+		{
+			bool blCurrent;
+			lock (modDefApp.g_objSockSync)
+			{
+				blCurrent = ReferenceEquals(m_sktSock, s);
+				if (blCurrent) m_sktSock = null;
+			}
+			try { s.Close(); } catch { }
+
+			lock (m_rxLock) { Monitor.PulseAll(m_rxLock); }				// 응답을 기다리는 쪽을 깨운다(받은 바이트는 남겨 둔다)
+			if (!blCurrent) return;
+
+			m_blSockConnected = false;
+			try { modCmWork.SetSocketCon(ref modDefApp.g_frmForm.picCliCom, modDefApp.ComSts.ComErr); } catch { }
+			if (!modDefApp.g_blIsAppExit)
+				modCmWork.ShowMsgClient("상위 접속이 끊겼습니다 - " + pWhy + ". 다시 접속합니다.", modDefApp.MSG_IMP);
+		}
+
+		// BeginSend 로 보내고 5초 안에 못 보내면 포기한다. 종료 요청이면 즉시 중단.
+		private void SendAsync(Socket s, byte[] pBuf, int pCnt)
+		{
+			int iOff = 0;
+			while (iOff < pCnt)
+			{
+				IAsyncResult ar = s.BeginSend(pBuf, iOff, pCnt - iOff, SocketFlags.None, null, null);
+				int iWait = 0;
+				while (!ar.AsyncWaitHandle.WaitOne(100, false))
+				{
+					iWait += 100;
+					if (modDefApp.g_blIsAppExit)
+					{
+						try { s.Close(); } catch { }
+						throw new System.IO.IOException("종료 요청으로 송신을 중단합니다.");
+					}
+					if (iWait >= SEND_TIMEOUT_MS)
+					{
+						try { s.Close(); } catch { }
+						throw new System.IO.IOException("송신 시간 초과(" + SEND_TIMEOUT_MS + "ms)");
+					}
+				}
+				iOff += s.EndSend(ar);
+			}
+		}
