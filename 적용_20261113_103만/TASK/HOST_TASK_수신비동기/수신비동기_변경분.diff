+		/// <summary>지정 포트가 로컬 또는 원격 포트인 IPv4 접속 전부</summary>
+		public static List<Row> List(int pPort)
+		{
+			List<Row> lst = new List<Row>();
+
+			int iSize = 0;
+			GetExtendedTcpTable(IntPtr.Zero, ref iSize, true, AF_INET, TCP_TABLE_OWNER_PID_ALL, 0);
+			IntPtr pTab = Marshal.AllocHGlobal(iSize + 4096);	// 두 호출 사이에 늘 수 있어 여유를 둔다
+			try
+			{
+				int iSize2 = iSize + 4096;
+				uint rc = GetExtendedTcpTable(pTab, ref iSize2, true, AF_INET, TCP_TABLE_OWNER_PID_ALL, 0);
+				if (rc != 0) throw new InvalidOperationException("GetExtendedTcpTable 실패(코드 " + rc + ")");
+
+				int n = Marshal.ReadInt32(pTab);
+				IntPtr pRow = new IntPtr(pTab.ToInt64() + 4);
+				int rowSize = Marshal.SizeOf(typeof(MIB_TCPROW_OWNER_PID));
+				for (int i = 0; i < n; i++)
+				{
+					MIB_TCPROW_OWNER_PID r = (MIB_TCPROW_OWNER_PID)Marshal.PtrToStructure(pRow, typeof(MIB_TCPROW_OWNER_PID));
+					pRow = new IntPtr(pRow.ToInt64() + rowSize);
+
+					int lp = PortOf(r.dwLocalPort);
+					int rp = PortOf(r.dwRemotePort);
+					if (lp != pPort && rp != pPort) continue;
+
+					Row x = new Row();
+					x.State = r.dwState;
+					x.RawLocalAddr = r.dwLocalAddr; x.RawLocalPort = r.dwLocalPort;
+					x.RawRemoteAddr = r.dwRemoteAddr; x.RawRemotePort = r.dwRemotePort;
+					x.LocalPort = lp; x.RemotePort = rp;
+					x.LocalIp = new IPAddress(r.dwLocalAddr).ToString();
+					x.RemoteIp = new IPAddress(r.dwRemoteAddr).ToString();
+					x.Pid = (int)r.dwOwningPid;
+					x.ProcName = "";
+					x.ProcAlive = false;
+					if (x.Pid > 0)
+					{
+						try { Process p = Process.GetProcessById(x.Pid); x.ProcName = p.ProcessName; x.ProcAlive = true; }
+						catch { }
+					}
+					lst.Add(x);
+				}
+			}
+			finally
+			{
+				Marshal.FreeHGlobal(pTab);
+			}
+			return lst;
+		}
