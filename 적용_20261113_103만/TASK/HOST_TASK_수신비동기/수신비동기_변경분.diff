+				// S/E 는 응답을 기다리지 않는다 (인터페이스명세서)
+				if (!p_bWaitRsps) return true;
+
+				string strWhy;
+				RxResult r = WaitFrame(s, p_iTimeOut, out strWhy);
+				if (r != RxResult.Ok)
+				{
+					if (r == RxResult.Timeout)
+					{
+						m_strLog = m_strHostCmd + " 메세지의 응답이 없습니다.";
+						modCmWork.ShowMsgClient(strTitle + m_strLog, modDefApp.MSG_ERR);
+					}
+					else
+					{
