+		private class KillItem
+		{
+			public int Pid;
+			public string Name;
+			public int NListen, NCloseWait, NOther;
+			public override string ToString()
+			{
+				StringBuilder sb = new StringBuilder();
+				if (NListen > 0) sb.Append("LISTENING " + NListen + "건 ");
+				if (NCloseWait > 0) sb.Append("CLOSE_WAIT " + NCloseWait + "건 ");
+				if (NOther > 0) sb.Append("그 밖 " + NOther + "건");
+				return "PID " + Pid + "  " + Name + "  (" + sb.ToString().Trim() + ")";
+			}
+		}
+
+		// TASKKILL 후보 : 이 포트가 로컬인 접속을 쥔 ★살아 있는★ 프로세스. 이 프로그램 자신·시스템 보호 프로세스는 뺀다.
+		private static List<KillItem> KillCandidates(List<Row> pRows, int pPort, out string pSkipNote)
+		{
+			List<KillItem> lst = new List<KillItem>();
+			StringBuilder skip = new StringBuilder();
+			int myPid = Process.GetCurrentProcess().Id;
+			List<int> seenSkip = new List<int>();
+			foreach (Row r in pRows)
+			{
+				if (r.LocalPort != pPort) continue;
+				if (!r.ProcAlive || r.Pid <= 4) continue;				// 소유 프로세스가 없으면 죽일 대상도 없다
+				bool blSkip = false; string why = "";
+				if (r.Pid == myPid) continue;						// 자기 자신은 목록에서 빼고, 아래 [자기 자신 종료] 확인으로 따로 묻는다
+				foreach (string nm in s_arrProtected)
+					if (string.Equals(r.ProcName, nm, StringComparison.OrdinalIgnoreCase)) { blSkip = true; why = "시스템 보호 프로세스"; break; }
+				if (blSkip)
+				{
+					if (!seenSkip.Contains(r.Pid)) { seenSkip.Add(r.Pid); skip.AppendLine("  PID " + r.Pid + " " + r.ProcName + " - " + why + "라 제외"); }
+					continue;
+				}
+				KillItem it = null;
+				foreach (KillItem x in lst) if (x.Pid == r.Pid) { it = x; break; }
+				if (it == null) { it = new KillItem(); it.Pid = r.Pid; it.Name = r.ProcName; lst.Add(it); }
+				if (r.State == STATE_LISTEN) it.NListen++;
+				else if (r.State == STATE_CLOSE_WAIT) it.NCloseWait++;
+				else it.NOther++;
+			}
+			pSkipNote = skip.ToString();
+			return lst;
+		}
