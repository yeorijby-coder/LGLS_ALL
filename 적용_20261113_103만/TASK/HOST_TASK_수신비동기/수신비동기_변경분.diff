+		private RxResult WaitFrame(Socket s, int pTimeoutSec, out string pWhy)
+		{
+			pWhy = "";
+			DateTime tmEnd = DateTime.Now.AddSeconds(pTimeoutSec);
+
+			lock (m_rxLock)
+			{
+				while (true)
+				{
+					if (m_rxLen >= modDefApp.MSG_HEAD_CNT)
+					{
+						int iBody = 0;
+						try { iBody = Convert.ToInt32(System.Text.Encoding.UTF8.GetString(m_rxQ, 10, 4)); }
+						catch { pWhy = "헤더의 정보가 틀립니다."; return RxResult.Invalid; }
+
+						if (iBody < 3)
+						{
+							pWhy = string.Format("Body의 길이가 '3' 이하 입니다.[Leng={0}]", iBody);
+							return RxResult.Invalid;
+						}
+						if (modDefApp.MSG_HEAD_CNT + iBody > m_bytRxBuff.Length)
+						{
+							pWhy = string.Format("Body의 길이가 허용 범위를 넘었습니다.[Leng={0}]", iBody);
+							return RxResult.Invalid;
+						}
+
+						int iFrame = modDefApp.MSG_HEAD_CNT + iBody;
+						if (m_rxLen >= iFrame)
+						{
+							if (m_rxQ[modDefApp.MSG_HEAD_CNT] != modDefApp.STX) { pWhy = "메세지의 시작이 'STX'가 아닙니다."; return RxResult.Invalid; }
+							if (m_rxQ[iFrame - 1] != modDefApp.ETX) { pWhy = "메세지의 끝이 ETX가 아닙니다."; return RxResult.Invalid; }
+
+							Buffer.BlockCopy(m_rxQ, 0, m_bytRxBuff, 0, iFrame);
+							m_rxLen -= iFrame;
+							if (m_rxLen > 0) Buffer.BlockCopy(m_rxQ, iFrame, m_rxQ, 0, m_rxLen);
+							return RxResult.Ok;
+						}
+					}
+
+					if (!ReferenceEquals(m_sktSock, s) || !m_blSockConnected) { pWhy = "응답을 기다리는 중 상위 접속이 끊겼습니다."; return RxResult.Closed; }
+					if (modDefApp.g_blIsAppExit) { pWhy = "종료 요청으로 응답 대기를 중단합니다."; return RxResult.Closed; }
+
+					double dLeftMs = (tmEnd - DateTime.Now).TotalMilliseconds;
+					if (dLeftMs <= 0) return RxResult.Timeout;
+					Monitor.Wait(m_rxLock, (int)Math.Min(dLeftMs, 200.0));
+				}
+			}
+		}
+
+		// RequestSrv 의 비동기 판 (반환값·로그 문구는 종전과 같다)
