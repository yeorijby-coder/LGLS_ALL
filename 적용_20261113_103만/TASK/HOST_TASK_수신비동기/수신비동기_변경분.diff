+﻿using System;
+using System.Net.Sockets;
+using System.Threading;
+
+namespace TSK_HostCom
+{
+	// [LGLS 2026-11-15] ★수신 비동기 전환★ (사용자 지시 - 구 ECP 의 TcpServer 와 같은 방식).
+	//   종전: 접속마다 스레드 하나가 Receive 에서 블로킹, 종료 때는 소켓을 닫고 그 스레드를 Join 으로 기다렸다.
+	//   지금: BeginReceive 상태기계(헤더 14 → 본문)로 받는다. 스레드를 잡고 있지 않으므로 Join 이 없다.
+	//         전문 하나가 완성되면 풀 스레드에서 검증 → Parsing(DB) → 응답 Send 를 ★접속별로 한 번에 하나씩★ 처리하고,
+	//         끝나면 다음 Receive 를 건다(처리 중에는 Receive 를 걸지 않으므로 한 접속의 순서와 응답 규칙은 종전과 같다).
+	//   종전 경로는 EcsComA.ini [Host] SRV_ASYNC=0 으로 되살릴 수 있다(SrvWorkThread 는 그대로 남아 있다).
+	//   Parsing / MakeResponse / SendSock / CheckHeader / CheckBody 는 한 줄도 바꾸지 않고 그대로 부른다.
+	partial class CSrvWork
+	{
+		// 비동기 수신 중(접속이 살아 있고 정리가 끝나지 않음). 종료 대기와 상태 표시에서 쓴다.
+		public volatile bool m_blRunning;
+
+		private int m_iRxState;		// 0 = 헤더 받는 중, 1 = 본문 받는 중
+		private int m_iRxGot;		// 이 단계에서 받은 바이트 수
+		private int m_iRxBodyLen;	// 헤더가 알려 준 본문 길이
+		private int m_iFin;			// 정리를 이미 했는가(한 번만)
+		private readonly ManualResetEvent m_evDone = new ManualResetEvent(false);
+
+		// 종료 때 정리가 끝나기를 기다린다 (ms < 0 이면 끝까지). 끝났으면 true.
+		public bool WaitDone(int pMs)
+		{
+			try { return pMs < 0 ? m_evDone.WaitOne() : m_evDone.WaitOne(pMs); }
+			catch { return true; }
+		}
+
+		// 콜백·워커는 풀 스레드에서 돈다. 로그 줄 앞의 상대 주소 접두는 스레드 전용 변수라 부를 때마다 채우고 비운다.
+		// 풀 스레드의 미처리 예외는 프로세스를 끝내므로 여기서 다 받아 이 접속만 정리한다.
+		private void Ctx(ThreadStart pBody)
+		{
+			string strOld = modCmWork.t_strPeer;
+			modCmWork.t_strPeer = m_strPeer;
+			try
+			{
+				pBody();
+			}
+			catch (Exception ex)
+			{
+				try { modCmWork.ShowMsgServer("[HOST_SRV] 예외 : " + ex.ToString(), modDefApp.MSG_ERR); } catch { }
+				try { Finish(false); } catch { }
+			}
+			finally
+			{
+				modCmWork.t_strPeer = strOld;
+			}
+		}
+
+		// 접속 직후 한 번 : 종전 SrvWorkThread 앞머리(DB 로그인)와 같고, 끝나면 첫 Receive 를 건다.
+		public void AsyncStart()
+		{
+			Ctx(delegate()
+			{
+				if (modDefApp.g_blIsAppExit) { Finish(false); return; }
+
+				string strLog = null;
+				string strErrMsg = null;
+
+				modDefApp.g_blSrvThread = true;
+				// 설비상태가 연속으로 많은량 수신 될 떄 SKIP을 위한 처리
+				m_tmSCMD_RecvTime = DateTime.Now.AddSeconds(-10);
+
+				modCmWork.SetSocketCon(ref modDefApp.g_frmForm.picSrvCom, modDefApp.ComSts.ComNor);
+
+				if (m_BDb.conMain != null)
+				{
+					m_BDb.conMain.Close();
+					modDefAPI.SleepA(3000);
+				}
+
+				modCmWork.ShowMsgServer("DB 로그인 중...", modDefApp.MSG_IMP);
+
+				if (!modCmLib.DBLogIn(ref m_BDb.conMain, ref strErrMsg))
+				{
+					m_blDbConnted = false;
+					strLog = string.Format("DB 연결 실패-{0}", strErrMsg);
+					modCmWork.ShowMsgServer(strLog, modDefApp.MSG_ERR);
+				}
+				else
+				{
+					m_blDbConnted = true;
+					modCmWork.ShowMsgServer("DB 로그인 성공.", modDefApp.MSG_IMP);
+					m_BDb.Init();
+				}
+
+				m_iRxState = 0;
+				m_iRxGot = 0;
+				ClearBuff(ref m_bytRxHead);
+				BeginRx();
+			});
+		}
+
+		// 지금 단계(헤더/본문)의 남은 만큼 Receive 를 건다
+		private void BeginRx()
+		{
+			Socket s = m_sktSock;
+			if (s == null || !modDefApp.g_blSrvThread || m_iFin != 0) { Finish(false); return; }
+
+			try
+			{
+				if (m_iRxState == 0)
+					s.BeginReceive(m_bytRxHead, m_iRxGot, modDefApp.MSG_HEAD_CNT - m_iRxGot, SocketFlags.None, new AsyncCallback(OnRx), s);
+				else
+					s.BeginReceive(m_bytRxBuff, modDefApp.MSG_HEAD_CNT + m_iRxGot, m_iRxBodyLen - m_iRxGot, SocketFlags.None, new AsyncCallback(OnRx), s);
+			}
+			catch (ObjectDisposedException) { Finish(false); }
+			catch (SocketException se) { RxFail(se); }
+		}
+
+		private void OnRx(IAsyncResult ar)
+		{
+			Ctx(delegate()
+			{
+				Socket s = (Socket)ar.AsyncState;
+				int n = 0;
+				try
+				{
+					n = s.EndReceive(ar);
+				}
+				catch (ObjectDisposedException) { Finish(false); return; }
+				catch (SocketException se) { RxFail(se); return; }
+
+				if (n <= 0)
+				{
+					// 상대가 끊었다(종전의 Receive 0 반환과 같다)
+					Finish(true);
+					return;
+				}
+
+				m_iRxGot += n;
+				if (m_iRxState == 0)
+				{
+					if (m_iRxGot < modDefApp.MSG_HEAD_CNT) { BeginRx(); return; }		// 헤더가 쪼개져 왔다 - 나머지를 기다린다
+					ThreadPool.QueueUserWorkItem(delegate(object st) { Ctx(OnHeader); });
+				}
+				else
+				{
+					if (m_iRxGot < m_iRxBodyLen) { BeginRx(); return; }					// 본문이 쪼개져 왔다
+					ThreadPool.QueueUserWorkItem(delegate(object st) { Ctx(OnBody); });
+				}
+			});
+		}
+
+		// 수신 오류. 우리가 소켓을 닫아서 생긴 것(종료)이면 조용히 끝내고, 그 밖에는 종전 문구를 남긴다.
+		private void RxFail(SocketException se)
+		{
+			if (m_sktSock == null || !modDefApp.g_blSrvThread || m_iFin != 0) { Finish(false); return; }
+			modCmWork.ShowMsgServer("리모트 시스템과 연결 실패 !" + "(" + se.ErrorCode.ToString() + ")", modDefApp.MSG_IMP);
+			Finish(true);
+		}
+
+		// 헤더 14바이트가 모였다 : 종전 ReadRequest 의 헤더 검사와 같다
+		private void OnHeader()
+		{
+			int iBodyLen = 0;
+			try
+			{
+				if (!CheckHeader(modDefApp.MSG_HEAD_CNT, ref iBodyLen))
+				{
+					// 잘못된 헤더 로그 + Nak 응답 후 끊는다 (종전과 같다)
+					modCmWork.ShowMsgServer(System.Text.Encoding.UTF8.GetString(m_bytRxHead), modDefApp.MSG_ERR);
+					SendSock();
+					Finish(true);
+					return;
+				}
+
+				// 종전에는 버퍼보다 큰 본문이면 Receive 가 예외를 내고 응답 없이 끊겼다. 이제 Nak 를 보내고 끊는다.
+				if (modDefApp.MSG_HEAD_CNT + iBodyLen > m_bytRxBuff.Length)
+				{
+					MakeResponse("X", "", modDefApp.MSG_INVALID_MSG_LENG);
+					modCmWork.ShowMsgServer(string.Format("메세지 길이가 허용 범위를 넘었습니다.[Leng={0}]", iBodyLen), modDefApp.MSG_ERR);
+					SendSock();
+					Finish(true);
+					return;
+				}
+
+				m_iRxBodyLen = iBodyLen;
+				m_iRxState = 1;
+				m_iRxGot = 0;
+				BeginRx();
+			}
+			catch (SocketException se) { RxFail(se); }
+			catch (Exception ex)
+			{
+				modCmWork.ShowMsgServer(ex.ToString(), modDefApp.MSG_ERR);
+				Finish(true);
+			}
+		}
+
+		// 본문까지 모였다 : 종전 ReadRequest 의 본문 검사 + SrvWorkThread 루프 한 바퀴와 같다
+		private void OnBody()
+		{
+			try
+			{
+				int iBodyLen = m_iRxBodyLen;
+
+				// 본문은 이미 다 받았으므로 길이 재시도(Sleep 500)는 건너뛰고 STX/ETX 만 본다
+				if (!CheckBody(iBodyLen, iBodyLen))
+				{
+					string strBad = System.Text.Encoding.UTF8.GetString(m_bytRxBuff, 0, modDefApp.MSG_HEAD_CNT + iBodyLen);
+					modCmWork.ShowMsgServer(strBad, modDefApp.MSG_ERR);
+					SendSock();
+					Finish(true);
+					return;
+				}
+
+				Parsing(iBodyLen);
+				// Response
+				SendSock();
+
+				// DB연결상태체크 (종전 SrvWorkThread 와 같은 판정)
+				string strSrvDbErr = m_BDb.ErrMsg;
+				string strCliDbErr = modDefApp.g_CliWork.m_BDb.ErrMsg;
+				bool blStopOld = modWorkThread.SrvStopOnCliDbErr && !string.IsNullOrEmpty(strCliDbErr);
+				if (!string.IsNullOrEmpty(strSrvDbErr) || blStopOld)
+				{
+					m_blDbConnted = false;
+					m_BDb.ErrMsg = "";
+					modCmWork.ShowMsgServer("DB 오류로 수신을 종료합니다(재접속 대기) : "
+						+ (blStopOld ? "[송신측] " + strCliDbErr : strSrvDbErr), modDefApp.MSG_ERR);
+					Finish(false);
+					return;
+				}
+				m_blDbConnted = true;
+
+				// 다음 전문
+				m_iRxState = 0;
+				m_iRxGot = 0;
+				ClearBuff(ref m_bytRxHead);
+				BeginRx();
+			}
+			catch (SocketException se) { RxFail(se); }
+			catch (Exception ex)
+			{
+				modCmWork.ShowMsgServer(ex.ToString(), modDefApp.MSG_ERR);
+				Finish(false);
+			}
+		}
+
+		// 이 접속의 뒷정리 (종전 SrvWorkThread 끝부분). 몇 번 불려도 한 번만 한다.
+		private void Finish(bool pRemoteLog)
+		{
+			if (Interlocked.Exchange(ref m_iFin, 1) != 0) return;
+
+			string strLog = null;
+
+			try { if (m_BDb.conMain != null) m_BDb.conMain.Close(); } catch { }
+			ReleaseDb();
+
+			m_blSockConnected = false;
+			try { modCmWork.CloseSocket(ref m_sktSock); } catch { }		// ★제 소켓만★ 닫는다
+
+			// Remote 에서 Close 할 시( Remote Close), return 0 시 로그
+			if (pRemoteLog)
+			{
+				modCmWork.ShowMsgServer("리모트 시스템과 연결을 종료합니다.", modDefApp.MSG_IMP);
+			}
+
+			// 목록에서 빼고, 남은 접속이 하나도 없을 때만 신호등을 끈다
+			int nLeft = 0;
+			lock (modDefApp.g_lstSrvWork)
+			{
+				modDefApp.g_lstSrvWork.Remove(this);
+				foreach (CSrvWork x in modDefApp.g_lstSrvWork)
+				{
+					Socket xs = x.m_sktSock;
+					if (xs != null && xs.Connected) nLeft++;
+				}
+			}
+			strLog = "통신 쓰레드를 종료합니다." + (nLeft > 0 ? " (남은 접속 " + nLeft + "개)" : "");
+			modCmWork.ShowMsgServer(strLog, modDefApp.MSG_IMP);
+			//소켓 연결종료표시
+			if (nLeft == 0)
+				modCmWork.SetSocketCon(ref modDefApp.g_frmForm.picSrvCom, modDefApp.ComSts.ComErr);
+
+			//--LKM[20140509]프로그램종료시 서버쓰레드종료 후 리슨쓰레드종료
+			if (modDefApp.g_blSrvThread == false)
+			{
+				modDefApp.g_blListenThread = false;
+			}
+
+			m_blRunning = false;
+			try { m_evDone.Set(); } catch { }
+		}
+
+		// 접속이 끝나면 이 접속의 DB 개체를 반납한다 (Close 만 하면 Connection/Command 가 가비지 수집을 기다리며 핸들을 잡는다)
+		private void ReleaseDb()
+		{
+			try
+			{
+				if (m_BDb == null) return;
+				try { if (m_BDb.conMain != null) { m_BDb.conMain.Close(); m_BDb.conMain.Dispose(); } } catch { }
+				try { if (m_BDb.comMain != null) m_BDb.comMain.Dispose(); } catch { }
+			}
+			catch { }
+		}
+	}
+}
