+		private static int PortOf(uint raw)
+		{
+			// 낮은 16비트가 네트워크 바이트 순서
+			return (int)(((raw & 0xFF) << 8) | ((raw >> 8) & 0xFF));
+		}
+
+		public static bool IsAdmin()
