+		// "PID 9940   cmd   핸들 0x3DC  0.0.0.0:9911  상대 -  [LISTENING]" → "PID 9940  cmd  (0.0.0.0:9911, LISTENING)" 로 줄여 보여 준다
+		private static string ShortHolder(string pLine)
+		{
+			System.Text.RegularExpressions.Match m = System.Text.RegularExpressions.Regex.Match(pLine,
+				@"^PID\s+(\d+)\s+(\S+)\s+핸들\s+(0x[0-9A-Fa-f]+)\s+(\S+)\s+상대\s+(\S+)\s+\[(.+?)\]");
+			if (!m.Success) return pLine;
+			return "PID " + m.Groups[1].Value + "  " + m.Groups[2].Value + "  (" + m.Groups[4].Value + ", " + m.Groups[6].Value + ")";
+		}
+
+		// "  PID 9940   cmd   핸들 0x3DC  0.0.0.0:18112  상대 -  [LISTENING]" 꼴의 줄만
+		private static List<string> HolderLines(string pOut)
+		{
+			List<string> lst = new List<string>();
+			foreach (string line in pOut.Split('\n'))
+			{
+				string t = line.TrimEnd('\r');
+				if (System.Text.RegularExpressions.Regex.IsMatch(t, @"^\s+PID\s+\d+\s")) lst.Add(t.Trim());
+			}
+			return lst;
+		}
