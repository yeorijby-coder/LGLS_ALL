+// [LGLS 2026-11-06] 완료처리와 함께 하는 [데이터 삭제] - 상태창 [데이터 삭제] 와 같은 요청(CMD_RQ_ID 'HMIDEL')을 먼저 남기고,
+//   설비 통신(WCS_TASK_CV VehThread)이 PLC M 비트에 쓴 뒤 CMD_RQ_YN 을 'N' 으로 돌릴 때까지 기다린다.
+//   그래야 삭제 → H/S 번호 기록 순서가 지켜진다(번호는 완료처리 뒤 IO_TASK 가 찍는다).
+//   기다리는 시간 Ecs.ini [MENU] HMIDEL_WAIT_SEC (기본 10). 넘기면 계속할지 묻고, 안 하면 요청을 거둔다.
+BOOL CPanelJobDlg::HmiDelBeforeComplete(const ROW& r, int nKind, const CString& strVehTbl, const CString& strVehWhere)
+{
+	if (m_pDoc == NULL || strVehTbl.IsEmpty()) return TRUE;
+	const BOOL bSc = (nKind == 3);
+	const CString strKeyCol = bSc ? _T("MC_NO") : _T("RTV_NO");
+
+	// 대상 설비 : 이 작업을 물고 있는 행 → 없으면 작업의 크레인 호기(RGV 는 한 대)
+	CString strKey, strMsg; int nCnt = -1;
+	CString strQ = _T("SELECT TOP 1 ") + strKeyCol + _T(" AS K FROM ") + strVehTbl + strVehWhere;
+	_RecordsetPtr ptr = m_pDoc->GetSelectQryRecordsetPtr_DLG(strQ, nCnt, strMsg);
+	if (nCnt > 0) { CRecordSetWrap* p = new CRecordSetWrap(ptr); p->MoveFirst(); strKey = p->GetItem(_T("K")); delete p; strKey.Trim(); }
+	if (strKey.IsEmpty())
+	{
+		if (bSc)
+		{
+			int nSc = r.sc.IsEmpty() ? m_nSeqSc : (_ttoi(r.sc) % 100);
+			if (nSc <= 0) nSc = m_nSeqSc;
+			if (nSc > 0) strKey.Format(_T("%d"), 900 + nSc);
+		}
+		else
+		{
+			nCnt = -1;
+			strQ.Format(_T("SELECT TOP 1 RTV_NO AS K FROM RTV_DATA_LGLS WHERE WH_TYP = '%s' ORDER BY RTV_NO"), (LPCTSTR)m_pDoc->m_WH_TYP);
+			ptr = m_pDoc->GetSelectQryRecordsetPtr_DLG(strQ, nCnt, strMsg);
+			if (nCnt > 0) { CRecordSetWrap* p = new CRecordSetWrap(ptr); p->MoveFirst(); strKey = p->GetItem(_T("K")); delete p; strKey.Trim(); }
+		}
+	}
+	if (strKey.IsEmpty())
+		return (AfxMessageBox(m_pDoc->GetMsgLangDef(_T("데이터 삭제를 보낼 설비를 찾지 못했습니다. 완료처리만 진행할까요?")), MB_YESNO | MB_ICONWARNING | MB_DEFBUTTON2) == IDYES);
+
+	CString strWhere;
+	strWhere.Format(_T(" WHERE WH_TYP = '%s' AND %s = '%s'"), (LPCTSTR)m_pDoc->m_WH_TYP, (LPCTSTR)strKeyCol, (LPCTSTR)strKey);
+	CString strSql = _T("UPDATE ") + strVehTbl + _T(" SET CMD_RQ_ID = 'HMIDEL', CMD_RQ_YN = 'Y'") + strWhere;
+	CString strLog;
+	strLog.Format(_T("데이터 삭제 신호 요청(HMIDEL) %s %s - 완료처리와 함께"), bSc ? _T("SC") : _T("RTV"), (LPCTSTR)strKey);
+	if (!ExecUpdate(strSql, strLog, r.lugg)) return FALSE;
+	CLib::UiLog(_T("[HMIDEL] request %s %s with complete %s"), bSc ? _T("SC") : _T("RTV"), (LPCTSTR)strKey, (LPCTSTR)r.lugg);
+
+	int nWait = ::GetPrivateProfileInt(_T("MENU"), _T("HMIDEL_WAIT_SEC"), 10, ECS_INI_FILE);
+	if (nWait < 1) nWait = 1;
+	BOOL bDone = FALSE;
+	{
+		CWaitCursor wc;
+		CString strChk = _T("SELECT CMD_RQ_YN AS YN FROM ") + strVehTbl + strWhere;
+		DWORD dwEnd = ::GetTickCount() + (DWORD)nWait * 1000;
+		while (!bDone)
+		{
+			::Sleep(300);
+			nCnt = -1;
+			ptr = m_pDoc->GetSelectQryRecordsetPtr_DLG(strChk, nCnt, strMsg);
+			if (nCnt > 0)
+			{
+				CRecordSetWrap* p = new CRecordSetWrap(ptr); p->MoveFirst();
+				CString yn = p->GetItem(_T("YN")); delete p; yn.Trim();
+				if (yn != _T("Y")) bDone = TRUE;
+			}
+			if ((LONG)(::GetTickCount() - dwEnd) >= 0) break;
+		}
+	}
+	if (bDone) { CLib::UiLog(_T("[HMIDEL] written %s"), (LPCTSTR)strKey); return TRUE; }
+
+	if (AfxMessageBox(m_pDoc->GetMsgLangDef(_T("데이터 삭제 신호가 아직 PLC 에 기록되지 않았습니다. 설비 통신을 확인하십시오.\n그래도 완료처리를 계속할까요?")),
+		MB_YESNO | MB_ICONWARNING | MB_DEFBUTTON2) == IDYES) return TRUE;
+	// 그만두면 요청을 거둔다 - 남겨 두면 통신이 살아날 때 뒤늦게 삭제가 나간다
+	ExecUpdate(_T("UPDATE ") + strVehTbl + _T(" SET CMD_RQ_YN = 'N'") + strWhere + _T(" AND CMD_RQ_YN = 'Y' AND CMD_RQ_ID = 'HMIDEL'"),
+		strLog + _T(" → 기록 대기 시간 초과로 요청 취소"), r.lugg);
+	return FALSE;
+}
