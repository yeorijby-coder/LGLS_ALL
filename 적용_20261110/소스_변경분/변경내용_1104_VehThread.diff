+        private string WriteHmiDelete(string strArea)
+        {
+            WcsCommon.cHmiDeleteMap.Area a = WcsCommon.cHmiDeleteMap.Get(strArea);
+            if (a == null || !a.Used)
+                return strArea + " 영역 미정의(WCS_DB.INI [HMI_DELETE] " + strArea + "_AREA/" + strArea + "_ADDR) - PLC 에 쓰지 않음";
